<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mail Server Dashboard</title>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0a0c10;
      --surface: #151921;
      --surface-2: #1c2230;
      --surface-3: #232a3a;
      --border: #2a3248;
      --border-hover: #3a4868;
      --text: #e6eaf0;
      --text-dim: #6b7a99;
      --text-muted: #4a5778;
      --accent: #818cf8;
      --accent-dim: #6366f1;
      --accent-glow: rgba(99,102,241,0.15);
      --green: #34d399;
      --green-dim: rgba(52,211,153,0.12);
      --red: #f87171;
      --red-dim: rgba(248,113,113,0.12);
      --yellow: #fbbf24;
      --yellow-dim: rgba(251,191,36,0.12);
      --blue: #60a5fa;
      --blue-dim: rgba(96,165,250,0.12);
      --cyan: #22d3ee;
      --cyan-dim: rgba(34,211,238,0.12);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'SF Pro Text', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* Header */
    .header {
      background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logo {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--accent) 0%, #a78bfa 100%);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
    }

    .header-title {
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .header-domain {
      font-size: 0.8125rem;
      color: var(--text-dim);
      font-family: 'SF Mono', 'Fira Code', monospace;
    }

    .header-right {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.3rem 0.875rem;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 500;
      border: 1px solid transparent;
    }

    .status-pill.online {
      background: var(--green-dim);
      color: var(--green);
      border-color: rgba(52,211,153,0.2);
    }

    .status-pill.offline {
      background: var(--red-dim);
      color: var(--red);
      border-color: rgba(248,113,113,0.2);
    }

    .status-pill .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .refresh-btn {
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text-dim);
      padding: 0.375rem 0.875rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.8125rem;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .refresh-btn:hover {
      background: var(--surface-3);
      color: var(--text);
      border-color: var(--border-hover);
    }

    .refresh-btn svg {
      width: 14px;
      height: 14px;
    }

    /* Main */
    .main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 1.5rem 2rem 3rem;
    }

    /* Grid */
    .grid { display: grid; gap: 1rem; }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }

    /* Cards */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      transition: border-color 0.15s ease;
    }

    .card:hover {
      border-color: var(--border-hover);
    }

    .card-label {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.625rem;
    }

    .card-value {
      font-size: 2.25rem;
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.1;
    }

    .card-sub {
      font-size: 0.8125rem;
      color: var(--text-dim);
      margin-top: 0.375rem;
    }

    /* Section */
    .section-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin: 2.25rem 0 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      padding: 0.625rem 1rem;
      text-align: left;
      font-size: 0.8125rem;
    }

    th {
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--border);
    }

    td {
      border-bottom: 1px solid rgba(42,50,72,0.5);
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.125rem 0.625rem;
      border-radius: 6px;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      font-family: 'SF Mono', 'Fira Code', monospace;
    }

    .badge-green { background: var(--green-dim); color: var(--green); }
    .badge-red { background: var(--red-dim); color: var(--red); }
    .badge-blue { background: var(--blue-dim); color: var(--blue); }
    .badge-yellow { background: var(--yellow-dim); color: var(--yellow); }

    /* Progress */
    .progress-track {
      height: 5px;
      background: var(--surface-3);
      border-radius: 3px;
      overflow: hidden;
      margin-top: 0.75rem;
    }

    .progress-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Mono */
    .mono {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.8125rem;
    }

    /* Colors */
    .text-green { color: var(--green); }
    .text-red { color: var(--red); }
    .text-yellow { color: var(--yellow); }
    .text-blue { color: var(--blue); }
    .text-dim { color: var(--text-dim); }
    .text-muted { color: var(--text-muted); }

    /* DNS Grid */
    .info-grid {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 0.375rem 0.75rem;
      align-items: baseline;
    }

    .info-label {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .info-value {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.75rem;
      word-break: break-all;
      color: var(--text-dim);
    }

    /* Check items */
    .check-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.3rem 0;
      font-size: 0.8125rem;
    }

    .check-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .check-dot.pass { background: var(--green); box-shadow: 0 0 6px var(--green-dim); }
    .check-dot.fail { background: var(--red); box-shadow: 0 0 6px var(--red-dim); }
    .check-dot.warn { background: var(--yellow); box-shadow: 0 0 6px var(--yellow-dim); }

    /* Score ring */
    .score-ring {
      position: relative;
      width: 64px;
      height: 64px;
      margin: 0.5rem auto 0.75rem;
    }

    .score-ring svg {
      transform: rotate(-90deg);
    }

    .score-ring-bg {
      fill: none;
      stroke: var(--surface-3);
      stroke-width: 4;
    }

    .score-ring-fill {
      fill: none;
      stroke-width: 4;
      stroke-linecap: round;
      transition: stroke-dasharray 0.6s ease;
    }

    .score-label {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.125rem;
      font-weight: 700;
    }

    /* Uptime chart */
    .uptime-chart-card {
      grid-column: 1 / -1;
    }

    .uptime-chart-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .uptime-chart-header .card-label { margin-bottom: 0; }

    .uptime-overall {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .uptime-bar-row {
      display: flex;
      gap: 2px;
      align-items: flex-end;
      height: 34px;
      margin-bottom: 0.375rem;
    }

    .uptime-bar {
      flex: 1;
      min-width: 0;
      border-radius: 2px;
      cursor: pointer;
      position: relative;
      transition: opacity 0.1s;
    }

    .uptime-bar:hover { opacity: 0.8; }

    .uptime-bar-tooltip {
      display: none;
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--surface-3);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.375rem 0.625rem;
      font-size: 0.6875rem;
      white-space: nowrap;
      z-index: 20;
      pointer-events: none;
      color: var(--text);
    }

    .uptime-bar:hover .uptime-bar-tooltip { display: block; }

    .uptime-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.6875rem;
      color: var(--text-muted);
    }

    .uptime-stats {
      display: flex;
      gap: 2rem;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }

    .uptime-stat {
      display: flex;
      flex-direction: column;
    }

    .uptime-stat-value {
      font-size: 1rem;
      font-weight: 600;
    }

    .uptime-stat-label {
      font-size: 0.6875rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .uptime-tabs {
      display: flex;
      gap: 0.25rem;
      background: var(--surface-2);
      border-radius: 8px;
      padding: 0.1875rem;
    }

    .uptime-tab {
      padding: 0.25rem 0.625rem;
      border-radius: 6px;
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--text-muted);
      cursor: pointer;
      border: none;
      background: none;
      transition: all 0.15s ease;
    }

    .uptime-tab:hover { color: var(--text-dim); }
    .uptime-tab.active {
      background: var(--surface-3);
      color: var(--text);
    }

    /* Email chart */
    .email-chart-card { grid-column: 1 / -1; }

    .chart-container {
      position: relative;
      height: 160px;
      display: flex;
      align-items: flex-end;
      gap: 1px;
      padding-top: 1.5rem;
    }

    .chart-col {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      position: relative;
      cursor: pointer;
    }

    .chart-col:hover .chart-col-tooltip { display: block; }

    .chart-bar-received {
      background: var(--accent);
      border-radius: 2px 2px 0 0;
      min-height: 0;
      transition: height 0.3s ease;
    }

    .chart-bar-sent {
      background: var(--cyan);
      border-radius: 0 0 2px 2px;
      min-height: 0;
      transition: height 0.3s ease;
    }

    .chart-col-tooltip {
      display: none;
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--surface-3);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.375rem 0.625rem;
      font-size: 0.6875rem;
      white-space: nowrap;
      z-index: 20;
      pointer-events: none;
      color: var(--text);
    }

    .chart-y-labels {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100%;
      pointer-events: none;
    }

    .chart-y-label {
      position: absolute;
      right: 0;
      font-size: 0.625rem;
      color: var(--text-muted);
      transform: translateY(-50%);
    }

    .chart-y-line {
      position: absolute;
      left: 0;
      right: 0;
      border-top: 1px dashed rgba(42,50,72,0.5);
    }

    .chart-legend {
      display: flex;
      gap: 1.25rem;
      margin-top: 0.625rem;
      font-size: 0.75rem;
      color: var(--text-dim);
    }

    .chart-legend-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      margin-right: 0.375rem;
      vertical-align: middle;
    }

    /* Activity stats mini cards */
    .activity-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }

    .mini-stat {
      text-align: center;
      padding: 1rem;
    }

    .mini-stat-value {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    .mini-stat-label {
      font-size: 0.6875rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-top: 0.375rem;
    }

    @media (max-width: 1024px) {
      .activity-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 640px) {
      .activity-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* Logs */
    .log-panel {
      grid-column: 1 / -1;
    }

    .log-tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.75rem;
    }

    .log-tab {
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      cursor: pointer;
      border: none;
      background: none;
      border-bottom: 2px solid transparent;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .log-tab:hover { color: var(--text-dim); }
    .log-tab.active {
      color: var(--text);
      border-bottom-color: var(--accent);
    }

    .log-tab-count {
      background: var(--surface-3);
      color: var(--text-dim);
      padding: 0.0625rem 0.375rem;
      border-radius: 4px;
      font-size: 0.625rem;
      font-weight: 600;
    }

    .log-tab.active .log-tab-count {
      background: var(--accent-glow);
      color: var(--accent);
    }

    .log-entries {
      max-height: 340px;
      overflow-y: auto;
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.75rem;
      line-height: 1.7;
    }

    .log-entries::-webkit-scrollbar { width: 4px; }
    .log-entries::-webkit-scrollbar-track { background: transparent; }
    .log-entries::-webkit-scrollbar-thumb { background: var(--surface-3); border-radius: 2px; }

    .log-entry {
      padding: 0.25rem 0;
      border-bottom: 1px solid rgba(42,50,72,0.3);
      display: flex;
      gap: 0.75rem;
      align-items: baseline;
    }

    .log-entry:last-child { border-bottom: none; }

    .log-time {
      color: var(--text-muted);
      white-space: nowrap;
      flex-shrink: 0;
      min-width: 70px;
    }

    .log-level {
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.625rem;
      padding: 0.0625rem 0.375rem;
      border-radius: 3px;
      flex-shrink: 0;
      min-width: 40px;
      text-align: center;
    }

    .log-level-error { background: var(--red-dim); color: var(--red); }
    .log-level-warn { background: var(--yellow-dim); color: var(--yellow); }
    .log-level-info { background: var(--blue-dim); color: var(--blue); }

    .log-msg {
      color: var(--text-dim);
      word-break: break-all;
      min-width: 0;
    }

    .log-empty {
      color: var(--text-muted);
      text-align: center;
      padding: 2rem;
      font-family: inherit;
      font-size: 0.8125rem;
    }

    /* Loading */
    .loading-overlay {
      position: fixed;
      inset: 0;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 50;
      gap: 1rem;
    }

    .loading-spinner {
      width: 28px;
      height: 28px;
      border: 2.5px solid var(--surface-3);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    .loading-text {
      color: var(--text-dim);
      font-size: 0.875rem;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* Last updated */
    .last-updated {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Forms */
    .form-row {
      display: flex;
      gap: 0.625rem;
      align-items: flex-end;
    }

    .form-group {
      flex: 1;
    }

    .form-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.375rem;
    }

    .form-input {
      width: 100%;
      padding: 0.5rem 0.75rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.8125rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .form-input:focus {
      border-color: var(--accent);
    }

    .form-input::placeholder {
      color: var(--text-muted);
    }

    .btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
    }

    .btn-primary:hover {
      background: var(--accent-dim);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.75rem 1.25rem;
      border-radius: 10px;
      font-size: 0.8125rem;
      font-weight: 500;
      z-index: 100;
      animation: slideUp 0.3s ease;
      max-width: 400px;
    }

    .toast-success {
      background: var(--green-dim);
      color: var(--green);
      border: 1px solid rgba(52,211,153,0.25);
    }

    .toast-error {
      background: var(--red-dim);
      color: var(--red);
      border: 1px solid rgba(248,113,113,0.25);
    }

    @keyframes slideUp {
      from { transform: translateY(1rem); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
      .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
      .main { padding: 1rem; }
      .header { padding: 1rem; }
    }
  </style>
</head>
<body>
  <div id="loading" class="loading-overlay">
    <div class="loading-spinner"></div>
    <div class="loading-text">Connecting to server...</div>
  </div>

  <header class="header">
    <div class="header-left">
      <div class="logo">&#9993;</div>
      <div>
        <div class="header-title">Mail Server Dashboard</div>
        <div class="header-domain" id="header-domain">--</div>
      </div>
    </div>
    <div class="header-right">
      <span class="last-updated" id="last-updated"></span>
      <span id="server-status" class="status-pill online">
        <span class="dot"></span> Checking...
      </span>
      <button class="refresh-btn" onclick="loadData()">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8a6 6 0 0 1 10.2-4.3M14 8a6 6 0 0 1-10.2 4.3"/><path d="M12.5 1v3.5H9M3.5 15v-3.5H7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Refresh
      </button>
    </div>
  </header>

  <main class="main">
    <!-- Uptime Chart -->
    <div class="grid">
      <div class="card uptime-chart-card">
        <div class="uptime-chart-header">
          <div>
            <div class="card-label">Uptime</div>
            <div style="font-size:0.8125rem;color:var(--text-dim);margin-top:0.25rem" id="uptime-summary">--</div>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem">
            <div class="uptime-tabs" id="uptime-tabs">
              <button class="uptime-tab" data-days="7">7d</button>
              <button class="uptime-tab" data-days="14">14d</button>
              <button class="uptime-tab" data-days="30">30d</button>
              <button class="uptime-tab" data-days="60">60d</button>
              <button class="uptime-tab active" data-days="90">90d</button>
            </div>
            <div class="uptime-overall text-green" id="uptime-overall">--</div>
          </div>
        </div>
        <div class="uptime-bar-row" id="uptime-bars"></div>
        <div class="uptime-labels">
          <span id="uptime-label-start">90 days ago</span>
          <span>Today</span>
        </div>
        <div class="uptime-stats">
          <div class="uptime-stat">
            <span class="uptime-stat-value text-green" id="uptime-current">--</span>
            <span class="uptime-stat-label">Current Uptime</span>
          </div>
          <div class="uptime-stat">
            <span class="uptime-stat-value" id="uptime-since" style="color:var(--text)">--</span>
            <span class="uptime-stat-label">Running Since</span>
          </div>
          <div class="uptime-stat">
            <span class="uptime-stat-value" id="uptime-incidents" style="color:var(--text)">--</span>
            <span class="uptime-stat-label">Incidents (90d)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Email Volume Chart -->
    <div class="grid" style="margin-top:1rem">
      <div class="card email-chart-card">
        <div class="uptime-chart-header">
          <div>
            <div class="card-label">Email Volume</div>
            <div style="font-size:0.8125rem;color:var(--text-dim);margin-top:0.25rem" id="email-chart-summary">--</div>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem">
            <div class="uptime-tabs" id="email-tabs">
              <button class="uptime-tab" data-email-days="7">7d</button>
              <button class="uptime-tab" data-email-days="14">14d</button>
              <button class="uptime-tab active" data-email-days="30">30d</button>
              <button class="uptime-tab" data-email-days="60">60d</button>
              <button class="uptime-tab" data-email-days="90">90d</button>
            </div>
          </div>
        </div>
        <div style="position:relative">
          <div class="chart-container" id="email-chart-bars"></div>
        </div>
        <div class="uptime-labels">
          <span id="email-label-start">30 days ago</span>
          <span>Today</span>
        </div>
        <div class="chart-legend">
          <span><span class="chart-legend-dot" style="background:var(--accent)"></span>Received</span>
          <span><span class="chart-legend-dot" style="background:var(--cyan)"></span>Sent</span>
        </div>
      </div>
    </div>

    <!-- Activity Stats -->
    <div class="section-title">Activity</div>
    <div class="activity-grid">
      <div class="card mini-stat">
        <div class="mini-stat-value text-green" id="stat-received">--</div>
        <div class="mini-stat-label">Received</div>
      </div>
      <div class="card mini-stat">
        <div class="mini-stat-value text-blue" id="stat-sent">--</div>
        <div class="mini-stat-label">Sent</div>
      </div>
      <div class="card mini-stat">
        <div class="mini-stat-value" style="color:var(--accent)" id="stat-connections">--</div>
        <div class="mini-stat-label">SMTP Connections</div>
      </div>
      <div class="card mini-stat">
        <div class="mini-stat-value" style="color:var(--cyan)" id="stat-imap">--</div>
        <div class="mini-stat-label">IMAP Sessions</div>
      </div>
      <div class="card mini-stat">
        <div class="mini-stat-value" id="stat-auth-fail">--</div>
        <div class="mini-stat-label">Auth Failures</div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="section-title">Overview</div>
    <div class="grid grid-4">
      <div class="card">
        <div class="card-label">Users</div>
        <div class="card-value" id="user-count">--</div>
        <div class="card-sub" id="user-list"></div>
      </div>
      <div class="card">
        <div class="card-label">Mailboxes</div>
        <div class="card-value" id="mailbox-count">--</div>
        <div class="card-sub" id="email-count"></div>
      </div>
      <div class="card">
        <div class="card-label">Disk Usage</div>
        <div class="card-value" id="disk-usage">--</div>
        <div class="progress-track">
          <div class="progress-fill" id="disk-bar" style="width:0%;background:var(--green)"></div>
        </div>
        <div class="card-sub" id="disk-detail"></div>
      </div>
      <div class="card">
        <div class="card-label">Storage per User</div>
        <div class="card-value" style="color:var(--cyan)" id="db-size">--</div>
        <div class="card-sub" id="db-detail"></div>
      </div>
    </div>

    <!-- Management -->
    <div class="section-title">Management</div>
    <div class="card">
      <div class="card-label">Create Account</div>
      <div class="card-sub" style="margin-bottom:0.75rem">Creates user credentials and mailbox (INBOX, Sent, Drafts, Trash, Junk)</div>
      <form id="create-account-form" onsubmit="return handleCreateAccount(event)">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Username</label>
            <input class="form-input" type="text" id="new-username" placeholder="e.g. john" required autocomplete="off">
          </div>
          <div class="form-group">
            <label class="form-label">Password</label>
            <input class="form-input" type="password" id="new-password" placeholder="min 8 characters" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary" id="create-account-btn">Create Account</button>
        </div>
      </form>
    </div>

    <!-- Logs -->
    <div class="section-title">Logs</div>
    <div class="grid">
      <div class="card log-panel">
        <div class="log-tabs">
          <button class="log-tab active" data-log="errors">Errors <span class="log-tab-count" id="log-count-errors">0</span></button>
          <button class="log-tab" data-log="auth">Auth Failures <span class="log-tab-count" id="log-count-auth">0</span></button>
          <button class="log-tab" data-log="warnings">Warnings <span class="log-tab-count" id="log-count-warnings">0</span></button>
          <button class="log-tab" data-log="smtp">SMTP Activity <span class="log-tab-count" id="log-count-smtp">0</span></button>
        </div>
        <div class="log-entries" id="log-entries">
          <div class="log-empty">Loading...</div>
        </div>
      </div>
    </div>

    <!-- Services -->
    <div class="section-title">Services</div>
    <div class="grid grid-2">
      <div class="card">
        <div class="card-label">Listening Ports</div>
        <table>
          <thead>
            <tr><th>Service</th><th>Port</th><th>Status</th></tr>
          </thead>
          <tbody id="ports-table">
            <tr><td colspan="3" class="text-muted">loading...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="card">
        <div class="card-label">System Services</div>
        <table>
          <thead>
            <tr><th>Service</th><th>Status</th></tr>
          </thead>
          <tbody id="services-table">
            <tr><td colspan="2" class="text-muted">loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Security & DNS -->
    <div class="section-title">Security &amp; Deliverability</div>
    <div class="grid grid-3">
      <div class="card">
        <div class="card-label">TLS Certificate</div>
        <div id="tls-info" style="margin-top:0.5rem">
          <span class="text-muted">loading...</span>
        </div>
      </div>
      <div class="card">
        <div class="card-label">DNS Records</div>
        <div id="dns-info" style="margin-top:0.5rem">
          <span class="text-muted">loading...</span>
        </div>
      </div>
      <div class="card" style="text-align:center;">
        <div class="card-label" style="text-align:left;">Deliverability Score</div>
        <div class="score-ring">
          <svg width="64" height="64" viewBox="0 0 64 64">
            <circle cx="32" cy="32" r="28" class="score-ring-bg"/>
            <circle cx="32" cy="32" r="28" class="score-ring-fill" id="score-arc"
              stroke="var(--green)" stroke-dasharray="0 176"/>
          </svg>
          <div class="score-label" id="score-label">--</div>
        </div>
        <div id="deliverability-info"></div>
      </div>
    </div>

    <!-- Resources -->
    <div class="section-title">Resources</div>
    <div class="grid grid-2">
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <div class="card-label">Memory</div>
          <div style="display:flex;align-items:baseline;gap:0.5rem">
            <span class="card-value text-blue" id="mem-usage" style="font-size:1.5rem">--</span>
            <span class="card-sub" id="mem-detail" style="margin-top:0"></span>
          </div>
        </div>
        <div class="progress-track" style="margin-top:0.5rem">
          <div class="progress-fill" id="mem-bar" style="width:0%;background:var(--blue)"></div>
        </div>
        <div style="position:relative;height:100px;margin-top:0.75rem">
          <canvas id="mem-chart" style="width:100%;height:100%"></canvas>
        </div>
      </div>
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <div class="card-label">CPU</div>
          <div style="display:flex;align-items:baseline;gap:0.5rem">
            <span class="card-value" id="cpu-usage" style="font-size:1.5rem;color:var(--accent)">--</span>
            <span class="card-sub" id="cpu-detail" style="margin-top:0"></span>
          </div>
        </div>
        <div class="progress-track" style="margin-top:0.5rem">
          <div class="progress-fill" id="cpu-bar" style="width:0%;background:var(--accent)"></div>
        </div>
        <div style="position:relative;height:100px;margin-top:0.75rem">
          <canvas id="cpu-chart" style="width:100%;height:100%"></canvas>
        </div>
      </div>
    </div>
  </main>

  <script>
    function $(id) { return document.getElementById(id) }

    async function loadData() {
      try {
        const res = await fetch('/api/status')
        const d = await res.json()
        if (d.error) throw new Error(d.error)
        render(d)
        $('last-updated').textContent = 'Updated ' + new Date().toLocaleTimeString()
      } catch (e) {
        $('server-status').className = 'status-pill offline'
        $('server-status').innerHTML = '<span class="dot"></span> Error'
        console.error('Failed to load status:', e)
      } finally {
        $('loading').style.display = 'none'
      }
    }

    function render(d) {
      _lastData = d
      // Header
      $('header-domain').textContent = d.dns?.a ? d.tls?.domain || '--' : '--'

      // Status
      const online = d.service === 'active'
      $('server-status').className = 'status-pill ' + (online ? 'online' : 'offline')
      $('server-status').innerHTML = '<span class="dot"></span> ' + (online ? 'Online' : 'Offline')

      // Uptime chart
      renderUptimeChart(d)

      // Stats
      $('user-count').textContent = d.userCount ?? '--'
      $('user-list').textContent = d.users?.join(', ') || ''
      $('mailbox-count').textContent = d.mailboxCount ?? '--'
      $('email-count').textContent = d.emailCount ? d.emailCount + ' total emails' : ''

      // Disk
      const pct = parseInt(d.diskPercent) || 0
      $('disk-usage').textContent = pct + '%'
      $('disk-bar').style.width = pct + '%'
      $('disk-bar').style.background = pct > 80 ? 'var(--red)' : pct > 60 ? 'var(--yellow)' : 'var(--green)'
      $('disk-detail').textContent = d.diskDetail || ''

      // Ports
      if (d.ports?.length) {
        $('ports-table').innerHTML = d.ports.map(p =>
          '<tr><td>' + p.service + '</td><td class="mono">' + p.port + '</td><td><span class="badge badge-green">' + p.status + '</span></td></tr>'
        ).join('')
      }

      // Services
      if (d.services?.length) {
        $('services-table').innerHTML = d.services.map(s =>
          '<tr><td>' + s.name + '</td><td><span class="badge ' + (s.active ? 'badge-green' : 'badge-red') + '">' + (s.active ? 'active' : 'inactive') + '</span></td></tr>'
        ).join('')
      }

      // TLS
      if (d.tls) {
        const color = d.tls.daysLeft > 30 ? 'text-green' : d.tls.daysLeft > 14 ? 'text-yellow' : 'text-red'
        $('tls-info').innerHTML =
          '<div class="check-item" style="margin-bottom:0.75rem"><span class="check-dot ' + (d.tls.valid ? 'pass' : 'fail') + '"></span><strong>' + (d.tls.valid ? 'Valid' : 'Invalid / Expired') + '</strong></div>' +
          '<div class="info-grid">' +
          '<span class="info-label">Domain</span><span class="info-value">' + (d.tls.domain || '--') + '</span>' +
          '<span class="info-label">Expires</span><span class="info-value ' + color + '">' + (d.tls.expiry || '--') + ' (' + d.tls.daysLeft + 'd left)</span>' +
          '<span class="info-label">Issuer</span><span class="info-value">' + (d.tls.issuer || '--') + '</span>' +
          '</div>'
      }

      // DNS
      if (d.dns) {
        $('dns-info').innerHTML =
          '<div class="info-grid">' +
          '<span class="info-label">MX</span><span class="info-value">' + (d.dns.mx || '--') + '</span>' +
          '<span class="info-label">A</span><span class="info-value">' + (d.dns.a || '--') + '</span>' +
          '<span class="info-label">rDNS</span><span class="info-value">' + (d.dns.rdns || '--') + '</span>' +
          '<span class="info-label">SPF</span><span class="info-value">' + (d.dns.spf || '--') + '</span>' +
          '<span class="info-label">DMARC</span><span class="info-value">' + (d.dns.dmarc || '--') + '</span>' +
          '<span class="info-label">DKIM</span><span class="info-value">' + (d.dns.dkim || '--') + '</span>' +
          '</div>'
      }

      // Deliverability score
      if (d.deliverability) {
        const passed = d.deliverability.filter(c => c.pass).length
        const total = d.deliverability.length
        const pctScore = Math.round((passed / total) * 100)
        const circumference = 2 * Math.PI * 28 // ~176
        const filled = (pctScore / 100) * circumference

        const arc = $('score-arc')
        arc.setAttribute('stroke-dasharray', filled + ' ' + circumference)
        arc.setAttribute('stroke', pctScore >= 80 ? 'var(--green)' : pctScore >= 50 ? 'var(--yellow)' : 'var(--red)')
        $('score-label').textContent = passed + '/' + total

        $('deliverability-info').innerHTML = d.deliverability.map(c =>
          '<div class="check-item"><span class="check-dot ' + (c.pass ? 'pass' : c.warn ? 'warn' : 'fail') + '"></span>' + c.label + '</div>'
        ).join('')
      }

      // Resources
      $('mem-usage').textContent = (d.memPercent ?? '--') + '%'
      $('mem-bar').style.width = (d.memPercent || 0) + '%'
      $('mem-detail').textContent = d.memDetail || ''

      $('cpu-usage').textContent = (d.cpuPercent ?? '--') + '%'
      $('cpu-bar').style.width = (d.cpuPercent || 0) + '%'
      $('cpu-detail').textContent = d.cpuDetail || ''

      // Resource charts
      if (d.resourceChart) {
        drawAreaChart('mem-chart', d.resourceChart.mem, d.resourceChart.labels, '96,165,250', 100)
        drawAreaChart('cpu-chart', d.resourceChart.cpu, d.resourceChart.labels, '129,140,248', 100)
      }

      $('db-size').textContent = d.dbSize || '--'
      $('db-detail').textContent = d.dbDetail || ''

      // Email chart
      renderEmailChart(d)

      // Logs
      renderLogs(d)

      // Activity stats
      $('stat-received').textContent = d.totalReceived ?? '--'
      $('stat-sent').textContent = d.totalSent ?? '--'
      $('stat-connections').textContent = d.smtpConnections ?? '--'
      $('stat-imap').textContent = d.imapSessions ?? '--'
      var af = d.authFails ?? 0
      $('stat-auth-fail').textContent = af
      $('stat-auth-fail').style.color = af > 10 ? 'var(--red)' : af > 0 ? 'var(--yellow)' : 'var(--green)'
    }

    var _uptimeData = null
    var _currentDays = 90

    function renderUptimeChart(d) {
      var chartData = d.uptimeChart || {}
      _uptimeData = { chartData: chartData, uptime: d.uptime, uptimeSince: d.uptimeSince }

      // Auto-select best timeframe based on data availability
      var totalWithData = chartData.daysWithData || 0
      if (totalWithData <= 2) {
        _currentDays = 7
      } else if (totalWithData <= 10) {
        _currentDays = 14
      } else if (totalWithData <= 21) {
        _currentDays = 30
      } else if (totalWithData <= 45) {
        _currentDays = 60
      } else {
        _currentDays = 90
      }

      // Update active tab
      updateActiveTab()
      renderUptimeBars()
    }

    function updateActiveTab() {
      var tabs = document.querySelectorAll('.uptime-tab')
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].className = 'uptime-tab' + (parseInt(tabs[i].getAttribute('data-days')) === _currentDays ? ' active' : '')
      }
    }

    function renderUptimeBars() {
      if (!_uptimeData) return
      var allDays = _uptimeData.chartData.days || {}
      var chart = allDays[_currentDays] || []
      var barsEl = $('uptime-bars')

      var html = ''
      var daysWithData = 0
      var totalPct = 0
      var incidents = 0

      for (var i = 0; i < chart.length; i++) {
        var day = chart[i]
        var color, height, label

        if (day.pct < 0) {
          color = 'var(--surface-3)'
          height = '4px'
          label = day.date + ' \u2014 No data'
        } else {
          daysWithData++
          totalPct += day.pct
          if (day.pct >= 99.5) {
            color = 'var(--green)'
            height = '100%'
            label = day.date + ' \u2014 ' + day.pct + '% uptime'
          } else if (day.pct >= 95) {
            color = 'var(--yellow)'
            height = Math.max(40, day.pct) + '%'
            label = day.date + ' \u2014 ' + day.pct + '% uptime'
            incidents++
          } else if (day.pct > 0) {
            color = '#f97316'
            height = Math.max(20, day.pct) + '%'
            label = day.date + ' \u2014 ' + day.pct + '% uptime'
            incidents++
          } else {
            color = 'var(--red)'
            height = '8px'
            label = day.date + ' \u2014 Down'
            incidents++
          }
        }

        html += '<div class="uptime-bar" style="height:' + height + ';background:' + color + '">'
        html += '<div class="uptime-bar-tooltip">' + label + '</div>'
        html += '</div>'
      }

      barsEl.innerHTML = html

      var overall = daysWithData > 0 ? (totalPct / daysWithData).toFixed(2) : '--'
      $('uptime-overall').textContent = overall + '%'
      $('uptime-overall').className = 'uptime-overall ' + (overall >= 99.5 ? 'text-green' : overall >= 95 ? 'text-yellow' : 'text-red')

      $('uptime-summary').textContent = daysWithData > 0
        ? daysWithData + ' day' + (daysWithData !== 1 ? 's' : '') + ' monitored, ' + (daysWithData - incidents) + ' perfect'
        : 'Collecting data...'

      $('uptime-current').textContent = _uptimeData.uptime || '--'
      $('uptime-since').textContent = _uptimeData.uptimeSince || '--'
      $('uptime-incidents').textContent = incidents.toString()
      $('uptime-incidents').style.color = incidents === 0 ? 'var(--green)' : 'var(--yellow)'

      $('uptime-label-start').textContent = chart.length > 0 ? chart[0].date : _currentDays + ' days ago'
    }

    // Email chart
    var _emailChartData = []
    var _emailDays = 30

    function renderEmailChart(d) {
      _emailChartData = d.emailChart || []
      renderEmailBars()
    }

    function renderEmailBars() {
      var chart = _emailChartData
      var days = _emailDays
      var slice = chart.slice(chart.length - days)
      var barsEl = $('email-chart-bars')

      // Find max for scaling
      var maxVal = 0
      var totalR = 0, totalS = 0
      for (var i = 0; i < slice.length; i++) {
        var total = slice[i].received + slice[i].sent
        if (total > maxVal) maxVal = total
        totalR += slice[i].received
        totalS += slice[i].sent
      }
      if (maxVal === 0) maxVal = 1

      var html = ''
      for (var i = 0; i < slice.length; i++) {
        var day = slice[i]
        var rH = (day.received / maxVal) * 100
        var sH = (day.sent / maxVal) * 100
        var totalH = rH + sH
        if (day.received + day.sent > 0 && totalH < 4) { rH = 4 }

        html += '<div class="chart-col" style="height:100%">'
        html += '<div class="chart-col-tooltip">' + day.date + '<br>Received: ' + day.received + ' &middot; Sent: ' + day.sent + '</div>'
        if (day.received > 0 || day.sent > 0) {
          html += '<div class="chart-bar-received" style="height:' + rH + '%"></div>'
          html += '<div class="chart-bar-sent" style="height:' + sH + '%"></div>'
        } else {
          html += '<div style="height:2px;background:var(--surface-3);border-radius:1px;margin-top:auto"></div>'
        }
        html += '</div>'
      }

      barsEl.innerHTML = html

      $('email-chart-summary').textContent = totalR + ' received, ' + totalS + ' sent in last ' + days + ' days'
      $('email-label-start').textContent = slice.length > 0 ? slice[0].date : days + ' days ago'

      // Update active tab
      var tabs = document.querySelectorAll('[data-email-days]')
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].className = 'uptime-tab' + (parseInt(tabs[i].getAttribute('data-email-days')) === _emailDays ? ' active' : '')
      }
    }

    // Tab click handlers
    document.addEventListener('click', function(e) {
      var target = e.target
      if (!target.classList.contains('uptime-tab')) return
      if (target.getAttribute('data-days')) {
        _currentDays = parseInt(target.getAttribute('data-days'))
        updateActiveTab()
        renderUptimeBars()
      } else if (target.getAttribute('data-email-days')) {
        _emailDays = parseInt(target.getAttribute('data-email-days'))
        renderEmailBars()
      }
    })

    // Area chart drawing
    function drawAreaChart(canvasId, data, labels, rgb, maxVal) {
      var canvas = $(canvasId)
      if (!canvas) return
      var dpr = window.devicePixelRatio || 1
      var rect = canvas.parentElement.getBoundingClientRect()
      var w = rect.width
      var h = rect.height
      canvas.width = w * dpr
      canvas.height = h * dpr
      canvas.style.width = w + 'px'
      canvas.style.height = h + 'px'

      var ctx = canvas.getContext('2d')
      ctx.scale(dpr, dpr)
      ctx.clearRect(0, 0, w, h)

      if (!data || data.length === 0) {
        ctx.fillStyle = 'rgba(' + rgb + ',0.3)'
        ctx.font = '11px -apple-system, system-ui, sans-serif'
        ctx.textAlign = 'center'
        ctx.fillText('Collecting data...', w / 2, h / 2)
        return
      }

      // If only 1 point, duplicate it so we can draw a flat line
      if (data.length === 1) {
        data = [data[0], data[0]]
        labels = [labels[0], labels[0]]
      }

      var padTop = 4
      var padBot = 14
      var chartH = h - padTop - padBot
      var stepX = w / (data.length - 1)

      // Grid lines
      ctx.strokeStyle = 'rgba(42,50,72,0.4)'
      ctx.lineWidth = 0.5
      for (var g = 0; g <= 4; g++) {
        var gy = padTop + (chartH * g / 4)
        ctx.beginPath()
        ctx.moveTo(0, gy)
        ctx.lineTo(w, gy)
        ctx.stroke()
      }

      // Y-axis labels
      ctx.fillStyle = 'rgba(74,87,120,0.8)'
      ctx.font = '9px -apple-system, system-ui, sans-serif'
      ctx.textAlign = 'right'
      ctx.fillText(maxVal + '%', w - 2, padTop + 8)
      ctx.fillText('0%', w - 2, h - padBot - 2)

      // Area fill
      ctx.beginPath()
      ctx.moveTo(0, padTop + chartH - (data[0] / maxVal) * chartH)
      for (var i = 1; i < data.length; i++) {
        var x = i * stepX
        var y = padTop + chartH - (data[i] / maxVal) * chartH
        ctx.lineTo(x, y)
      }
      ctx.lineTo(w, padTop + chartH)
      ctx.lineTo(0, padTop + chartH)
      ctx.closePath()
      var grad = ctx.createLinearGradient(0, padTop, 0, padTop + chartH)
      grad.addColorStop(0, 'rgba(' + rgb + ',0.25)')
      grad.addColorStop(1, 'rgba(' + rgb + ',0.02)')
      ctx.fillStyle = grad
      ctx.fill()

      // Line
      ctx.beginPath()
      ctx.moveTo(0, padTop + chartH - (data[0] / maxVal) * chartH)
      for (var i = 1; i < data.length; i++) {
        var x = i * stepX
        var y = padTop + chartH - (data[i] / maxVal) * chartH
        ctx.lineTo(x, y)
      }
      ctx.strokeStyle = 'rgba(' + rgb + ',0.8)'
      ctx.lineWidth = 1.5
      ctx.stroke()

      // Time labels
      ctx.fillStyle = 'rgba(74,87,120,0.6)'
      ctx.font = '9px -apple-system, system-ui, sans-serif'
      ctx.textAlign = 'center'
      if (labels.length >= 2) {
        var first = new Date(labels[0])
        var last = new Date(labels[labels.length - 1])
        ctx.textAlign = 'left'
        ctx.fillText(formatTimeLabel(first), 2, h - 2)
        ctx.textAlign = 'right'
        ctx.fillText(formatTimeLabel(last), w - 2, h - 2)
        if (labels.length > 10) {
          var mid = new Date(labels[Math.floor(labels.length / 2)])
          ctx.textAlign = 'center'
          ctx.fillText(formatTimeLabel(mid), w / 2, h - 2)
        }
      }
    }

    function formatTimeLabel(d) {
      var now = new Date()
      var diff = now.getTime() - d.getTime()
      if (diff < 86400000) {
        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      }
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    }

    // Redraw charts on resize
    var _resizeTimer
    window.addEventListener('resize', function() {
      clearTimeout(_resizeTimer)
      _resizeTimer = setTimeout(function() { if (_lastData) render(_lastData) }, 200)
    })
    var _lastData = null

    // Logs
    var _logData = {}
    var _activeLogTab = 'errors'

    function renderLogs(d) {
      _logData = {
        errors: d.errors || [],
        auth: d.authFailDetails || [],
        warnings: d.warnings || [],
        smtp: d.recentSmtp || [],
      }

      $('log-count-errors').textContent = _logData.errors.length
      $('log-count-auth').textContent = _logData.auth.length
      $('log-count-warnings').textContent = _logData.warnings.length
      $('log-count-smtp').textContent = _logData.smtp.length

      // Color the error count red if > 0
      if (_logData.errors.length > 0) $('log-count-errors').style.cssText = 'background:var(--red-dim);color:var(--red)'
      if (_logData.auth.length > 0) $('log-count-auth').style.cssText = 'background:var(--yellow-dim);color:var(--yellow)'

      renderLogEntries()
    }

    function renderLogEntries() {
      var entries = _logData[_activeLogTab] || []
      var el = $('log-entries')

      if (entries.length === 0) {
        el.innerHTML = '<div class="log-empty">No ' + _activeLogTab + ' to show</div>'
        return
      }

      // Show newest first
      var sorted = entries.slice().reverse()
      var html = ''
      for (var i = 0; i < sorted.length; i++) {
        var e = sorted[i]
        var time = e.ts ? new Date(e.ts * 1000).toLocaleString() : '--'
        var levelClass = e.level === 'ERROR' ? 'error' : e.level === 'WARN' ? 'warn' : 'info'
        var msg = e.message
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')

        html += '<div class="log-entry">'
        html += '<span class="log-time">' + time + '</span>'
        html += '<span class="log-level log-level-' + levelClass + '">' + e.level + '</span>'
        html += '<span class="log-msg">' + msg + '</span>'
        html += '</div>'
      }

      el.innerHTML = html
    }

    // Log tab click handler
    document.addEventListener('click', function(e) {
      if (e.target.closest && e.target.closest('.log-tab')) {
        var tab = e.target.closest('.log-tab')
        var key = tab.getAttribute('data-log')
        if (!key) return
        _activeLogTab = key
        var tabs = document.querySelectorAll('.log-tab')
        for (var i = 0; i < tabs.length; i++) {
          tabs[i].className = 'log-tab' + (tabs[i].getAttribute('data-log') === key ? ' active' : '')
        }
        renderLogEntries()
      }
    })

    function showToast(message, type) {
      var existing = document.querySelector('.toast')
      if (existing) existing.remove()
      var el = document.createElement('div')
      el.className = 'toast toast-' + type
      el.textContent = message
      document.body.appendChild(el)
      setTimeout(function() { el.remove() }, 4000)
    }

    async function handleCreateAccount(e) {
      e.preventDefault()
      var btn = $('create-account-btn')
      btn.disabled = true
      btn.textContent = 'Creating...'
      try {
        var res = await fetch('/api/account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: $('new-username').value.trim(),
            password: $('new-password').value
          })
        })
        var data = await res.json()
        if (data.ok) {
          showToast('Account "' + $('new-username').value.trim() + '" created with mailbox', 'success')
          $('new-username').value = ''
          $('new-password').value = ''
          loadData()
        } else {
          showToast(data.error || 'Failed to create account', 'error')
        }
      } catch (err) {
        showToast('Network error: ' + err.message, 'error')
      } finally {
        btn.disabled = false
        btn.textContent = 'Create Account'
      }
      return false
    }

    loadData()
    setInterval(loadData, 30000)
  </script>
</body>
</html>
