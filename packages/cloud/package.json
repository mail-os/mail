{
  "name": "mail-cloud",
  "type": "module",
  "version": "0.3.5",
  "description": "AWS Infrastructure for Mail Server using ts-cloud",
  "author": "Chris Breuer",
  "license": "MIT",
  "scripts": {
    "build": "bun --bun build.ts",
    "test": "bun test",
    "cloud": "bunx --bun cloud",
    "generate": "bunx --bun cloud generate",
    "generate:dev": "bunx --bun cloud generate --env dev",
    "generate:staging": "bunx --bun cloud generate --env staging",
    "generate:prod": "bunx --bun cloud generate --env production",
    "diff": "bunx --bun cloud diff",
    "diff:dev": "bunx --bun cloud diff --env dev",
    "diff:staging": "bunx --bun cloud diff --env staging",
    "diff:prod": "bunx --bun cloud diff --env production",
    "deploy": "bunx --bun cloud deploy",
    "deploy:dev": "bunx --bun cloud deploy --env dev",
    "deploy:staging": "bunx --bun cloud deploy --env staging",
    "deploy:prod": "bunx --bun cloud deploy --env production",
    "destroy": "bunx --bun cloud stack:delete mail-server-production",
    "destroy:dev": "bunx --bun cloud stack:delete mail-server-dev",
    "destroy:staging": "bunx --bun cloud stack:delete mail-server-staging",
    "destroy:prod": "bunx --bun cloud stack:delete mail-server-production",
    "status": "bunx --bun cloud deploy:status",
    "status:dev": "bunx --bun cloud deploy:status --env dev",
    "status:staging": "bunx --bun cloud deploy:status --env staging",
    "status:prod": "bunx --bun cloud deploy:status --env production",
    "stacks": "bunx --bun cloud stack:list",
    "doctor": "bunx --bun cloud doctor",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "keywords": [
    "ts-cloud",
    "aws",
    "mail-server",
    "infrastructure",
    "cloudformation"
  ],
  "dependencies": {
    "@stacksjs/ts-cloud": "^0.11.0"
  },
  "devDependencies": {
    "better-dx": "^0.2.23"
  }
}
