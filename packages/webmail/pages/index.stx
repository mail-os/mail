<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Webmail</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <!--
    Standalone page (no @extends): explicit DOM rendering via <script>, matching
    the proven packages/devtools/pages/app.stx approach. All data comes from the
    Zig backend's JSON API at /webmail/*.
  -->
  <div class="wm" id="app">
    <aside class="wm-folders">
      <div class="wm-brand">📬 Webmail</div>
      <button class="wm-compose-btn" id="composeBtn">✏️ Compose</button>
      <nav class="wm-folder-list" id="folderList"></nav>
      <div class="wm-user">
        <span class="wm-user-email" id="userEmail"></span>
        <button class="wm-logout" id="logoutBtn">Sign out</button>
      </div>
    </aside>

    <section class="wm-list">
      <header class="wm-list-head">
        <span class="wm-list-title" id="listTitle">INBOX</span>
        <button class="wm-refresh" id="refreshBtn" title="Refresh">⟳</button>
      </header>
      <div class="wm-list-body" id="messageList"></div>
    </section>

    <section class="wm-read" id="readPane">
      <button class="wm-back" id="backBtn">← Back</button>
      <div class="wm-read-empty wm-state" id="readEmpty">Select a message to read.</div>
      <article class="wm-read-body" id="readBody" style="display:none"></article>
    </section>
  </div>

  <!-- Composer modal -->
  <div class="wm-modal" id="composeModal" style="display:none">
    <div class="wm-composer">
      <header class="wm-composer-head">
        <span id="composerTitle">New message</span>
        <button class="wm-composer-close" id="composerClose" title="Close">✕</button>
      </header>
      <div class="wm-composer-fields">
        <label>To <input type="text" id="cTo" placeholder="recipient@example.com, …" /></label>
        <label>Cc <input type="text" id="cCc" placeholder="optional" /></label>
        <label>Bcc <input type="text" id="cBcc" placeholder="optional" /></label>
        <label>Subject <input type="text" id="cSubject" /></label>
      </div>
      <textarea class="wm-composer-body" id="cBody" placeholder="Write your message…"></textarea>
      <p class="wm-composer-error" id="composerError" style="display:none"></p>
      <footer class="wm-composer-foot">
        <button class="wm-send-btn" id="sendBtn">Send</button>
        <span class="wm-composer-status" id="composerStatus"></span>
      </footer>
    </div>
  </div>

  <script>
    const state = { user: null, folder: 'INBOX', messages: [], selectedUid: null, suppressAutoRead: new Set() }

    // HTML-escape untrusted text before inserting via innerHTML.
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;')
    }

    function shortDate(d) {
      if (!d) return ''
      const t = Date.parse(d)
      if (isNaN(t)) return esc(d)
      const dt = new Date(t), now = new Date()
      return dt.toDateString() === now.toDateString()
        ? dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        : dt.toLocaleDateString([], { month: 'short', day: 'numeric' })
    }

    async function api(path, opts) {
      const res = await fetch(path, { credentials: 'same-origin', ...(opts || {}) })
      if (res.status === 401) { window.location.href = '/login'; throw new Error('unauthorized') }
      return res
    }

    async function init() {
      try {
        const me = await api('/webmail/auth/me')
        if (me.ok) { state.user = (await me.json()).user; document.getElementById('userEmail').textContent = state.user.email }
        await loadFolders()
        await loadMessages()
      } catch (_e) { /* 401 already redirected */ }
    }

    async function loadFolders() {
      const res = await api('/webmail/api/folders')
      if (!res.ok) return
      const folders = await res.json()
      document.getElementById('folderList').innerHTML = folders.map(f => `
        <a class="wm-folder ${f.name === state.folder ? 'wm-folder--active' : ''}" data-folder="${esc(f.name)}">
          <span class="wm-folder-name">${esc(f.name)}</span>
          ${f.unread > 0 ? `<span class="wm-folder-count">${f.unread}</span>` : ''}
        </a>`).join('')
      document.querySelectorAll('.wm-folder').forEach(el => {
        el.addEventListener('click', () => selectFolder(el.getAttribute('data-folder')))
      })
    }

    async function loadMessages() {
      const list = document.getElementById('messageList')
      list.innerHTML = '<div class="wm-state">Loading…</div>'
      const res = await api('/webmail/api/messages?folder=' + encodeURIComponent(state.folder))
      if (!res.ok) { list.innerHTML = '<div class="wm-state">Failed to load.</div>'; return }
      state.messages = (await res.json()).items || []
      renderList()
    }

    function renderList() {
      const list = document.getElementById('messageList')
      if (state.messages.length === 0) {
        list.innerHTML = '<div class="wm-state">No messages in this folder.</div>'
        return
      }
      list.innerHTML = state.messages.map(m => `
        <div class="wm-msg ${m.uid === state.selectedUid ? 'wm-msg--active' : ''} ${m.flags && m.flags.seen ? '' : 'wm-msg--unread'}" data-uid="${m.uid}">
          <div class="wm-msg-row">
            <span class="wm-msg-from">${esc(m.from)}</span>
            <span class="wm-msg-date">${shortDate(m.date)}</span>
          </div>
          <div class="wm-msg-subject">${m.flags && m.flags.flagged ? '<span class="wm-msg-flag" title="Flagged">★</span> ' : ''}${esc(m.subject || '(no subject)')}</div>
          <div class="wm-msg-snippet">${esc(m.snippet)}</div>
          ${m.has_attachments ? '<span class="wm-msg-attach" title="Has attachments">📎</span>' : ''}
        </div>`).join('')
      list.querySelectorAll('.wm-msg').forEach(el => {
        el.addEventListener('click', () => openMessage(parseInt(el.getAttribute('data-uid'), 10)))
      })
    }

    async function selectFolder(name) {
      if (name === state.folder) return
      state.folder = name
      state.selectedUid = null
      state.suppressAutoRead.clear() // UIDs are per-folder; don't carry across
      document.getElementById('listTitle').textContent = name
      document.getElementById('app').classList.remove('wm--reading')
      showReadEmpty()
      await loadFolders()
      await loadMessages()
    }

    async function openMessage(uid) {
      state.selectedUid = uid
      renderList()
      document.getElementById('app').classList.add('wm--reading')
      const empty = document.getElementById('readEmpty')
      const body = document.getElementById('readBody')
      empty.style.display = 'none'
      body.style.display = 'block'
      body.innerHTML = '<div class="wm-state">Loading message…</div>'

      const res = await api('/webmail/api/messages/' + uid + '?folder=' + encodeURIComponent(state.folder))
      if (!res.ok) { body.innerHTML = '<div class="wm-state">Failed to load message.</div>'; return }
      const m = await res.json()
      renderMessage(m)

      // Auto mark-read on open (only if currently unread). Skipped if the user
      // just manually marked this message unread — otherwise re-opening would
      // immediately re-mark it read and the two PUTs would race.
      const item = state.messages.find(x => x.uid === uid)
      if (item && item.flags && !item.flags.seen && !state.suppressAutoRead.has(uid)) {
        item.flags.seen = true
        renderList()
        const ok = await mutateFlags(uid, item.flags)
        if (ok) { await loadFolders() } else { item.flags.seen = false; renderList() }
      }
    }

    // Mutating request helper: PUT flags/move. Same-origin header satisfies the
    // backend CSRF guard. Returns the parsed JSON or null on failure.
    async function mutateFlags(uid, flags) {
      try {
        const res = await api('/webmail/api/messages/' + uid + '?folder=' + encodeURIComponent(state.folder), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Origin': window.location.origin },
          body: JSON.stringify({ flags }),
        })
        return res.ok ? await res.json() : null
      } catch (_e) { return null }
    }

    function currentMessage() {
      return state.messages.find(x => x.uid === state.selectedUid)
    }

    async function toggleFlag() {
      const m = currentMessage()
      if (!m) return
      m.flags.flagged = !m.flags.flagged
      renderList(); renderMessage(m)
      const ok = await mutateFlags(m.uid, m.flags)
      if (!ok) { m.flags.flagged = !m.flags.flagged; renderList(); renderMessage(m) } // rollback
    }

    async function markUnread() {
      const m = currentMessage()
      if (!m) return
      m.flags.seen = false
      // Remember so a subsequent open() doesn't auto-re-mark-read and race us.
      state.suppressAutoRead.add(m.uid)
      renderList(); renderMessage(m)
      const ok = await mutateFlags(m.uid, m.flags)
      if (ok) { await loadFolders() } else { m.flags.seen = true; renderList(); renderMessage(m) }
    }

    async function deleteCurrent() {
      const m = currentMessage()
      if (!m) return
      const uid = m.uid
      // Optimistic: drop from list + close reader.
      state.messages = state.messages.filter(x => x.uid !== uid)
      state.selectedUid = null
      document.getElementById('app').classList.remove('wm--reading')
      showReadEmpty(); renderList()
      try {
        await api('/webmail/api/messages/' + uid + '?folder=' + encodeURIComponent(state.folder), {
          method: 'DELETE',
          headers: { 'Origin': window.location.origin },
        })
      } catch (_e) { /* best-effort; refresh will reconcile */ }
      await loadFolders()
      await loadMessages()
    }

    function renderMessage(m) {
      const body = document.getElementById('readBody')
      const attachments = (m.attachments || []).map(a =>
        `<span class="wm-attach-chip">📎 ${esc(a.filename)}</span>`).join('')
      const flags = m.flags || {}

      body.innerHTML = `
        <div class="wm-read-toolbar">
          <button class="wm-action" data-act="reply" title="Reply">↩ Reply</button>
          <button class="wm-action" data-act="replyall" title="Reply all">↩↩ Reply all</button>
          <button class="wm-action" data-act="forward" title="Forward">↪ Forward</button>
          <button class="wm-action" data-act="flag" title="Flag">${flags.flagged ? '★ Flagged' : '☆ Flag'}</button>
          <button class="wm-action" data-act="unread" title="Mark unread">Mark unread</button>
          <button class="wm-action wm-action--danger" data-act="delete" title="Delete">🗑 Delete</button>
        </div>
        <h2 class="wm-read-subject">${esc(m.subject || '(no subject)')}</h2>
        <div class="wm-read-meta">
          <div><span class="wm-read-label">From</span> ${esc(m.from)}</div>
          <div><span class="wm-read-label">To</span> ${esc(m.to)}</div>
          ${m.cc ? `<div><span class="wm-read-label">Cc</span> ${esc(m.cc)}</div>` : ''}
          <div><span class="wm-read-label">Date</span> ${esc(m.date)}</div>
        </div>
        ${attachments ? `<div class="wm-read-attach">${attachments}</div>` : ''}
        ${m.html
          ? '<iframe class="wm-read-html" sandbox="" referrerpolicy="no-referrer"></iframe>'
          : `<pre class="wm-read-text">${esc(m.text)}</pre>`}
      `
      // Inject HTML email into a sandboxed iframe via srcdoc. The empty sandbox
      // blocks scripts, forms, popups and same-origin access, so attacker
      // markup can't run or read the session cookie.
      if (m.html) {
        const frame = body.querySelector('.wm-read-html')
        frame.srcdoc = m.html
      }
      body.querySelectorAll('.wm-action').forEach(btn => {
        btn.addEventListener('click', () => {
          const act = btn.getAttribute('data-act')
          if (act === 'flag') toggleFlag()
          else if (act === 'unread') markUnread()
          else if (act === 'delete') deleteCurrent()
          else if (act === 'reply') openReply(m, false)
          else if (act === 'replyall') openReply(m, true)
          else if (act === 'forward') openForward(m)
        })
      })
    }

    function showReadEmpty() {
      document.getElementById('readEmpty').style.display = 'block'
      document.getElementById('readBody').style.display = 'none'
    }

    document.getElementById('refreshBtn').addEventListener('click', loadMessages)
    document.getElementById('backBtn').addEventListener('click', () => {
      state.selectedUid = null
      document.getElementById('app').classList.remove('wm--reading')
      showReadEmpty()
      renderList()
    })
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        await fetch('/webmail/auth/logout', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Origin': window.location.origin },
        })
      } catch (_e) { /* ignore */ }
      window.location.href = '/login'
    })

    // ── Composer ────────────────────────────────────────────────────────────
    const composer = {
      modal: document.getElementById('composeModal'),
      title: document.getElementById('composerTitle'),
      to: document.getElementById('cTo'),
      cc: document.getElementById('cCc'),
      bcc: document.getElementById('cBcc'),
      subject: document.getElementById('cSubject'),
      body: document.getElementById('cBody'),
      error: document.getElementById('composerError'),
      status: document.getElementById('composerStatus'),
      sendBtn: document.getElementById('sendBtn'),
      // Threading headers carried from the message being replied to.
      inReplyTo: '',
      references: '',
    }

    function openComposer(title) {
      composer.title.textContent = title
      composer.error.style.display = 'none'
      composer.status.textContent = ''
      composer.modal.style.display = 'flex'
    }
    function resetComposer() {
      composer.to.value = ''; composer.cc.value = ''; composer.bcc.value = ''
      composer.subject.value = ''; composer.body.value = ''
      composer.inReplyTo = ''; composer.references = ''
    }
    function closeComposer() { composer.modal.style.display = 'none' }

    // Pull a bare email address out of a "Name <addr>" header value.
    function bareAddr(s) {
      const m = /<([^>]+)>/.exec(s || '')
      return (m ? m[1] : (s || '')).trim()
    }
    // Split a comma-separated recipient field into trimmed non-empty addresses.
    function parseList(s) {
      return (s || '').split(',').map(x => bareAddr(x)).filter(Boolean)
    }

    function quoteBody(m) {
      const who = m.from || 'someone'
      const when = m.date || ''
      const text = (m.text && m.text.length) ? m.text : (m.html ? '[HTML message]' : '')
      const quoted = text.split('\n').map(l => '> ' + l).join('\n')
      return `\n\nOn ${when}, ${who} wrote:\n${quoted}\n`
    }

    function openReply(m, all) {
      resetComposer()
      composer.to.value = bareAddr(m.from)
      if (all) {
        // Reply-all: add original To/Cc minus ourselves.
        const me = (state.user && state.user.email) || ''
        const extra = [...parseList(m.to), ...parseList(m.cc)].filter(a => a !== me && a !== bareAddr(m.from))
        if (extra.length) composer.cc.value = extra.join(', ')
      }
      const subj = m.subject || ''
      composer.subject.value = /^re:/i.test(subj) ? subj : 'Re: ' + subj
      composer.body.value = quoteBody(m)
      // Threading: In-Reply-To = this message's Message-ID; References appends it.
      composer.inReplyTo = m.message_id || ''
      composer.references = m.message_id || ''
      openComposer(all ? 'Reply all' : 'Reply')
      composer.body.focus()
      composer.body.setSelectionRange(0, 0)
    }

    function openForward(m) {
      resetComposer()
      const subj = m.subject || ''
      composer.subject.value = /^fwd:/i.test(subj) ? subj : 'Fwd: ' + subj
      const text = (m.text && m.text.length) ? m.text : (m.html ? '[HTML message]' : '')
      composer.body.value = `\n\n---------- Forwarded message ----------\nFrom: ${m.from}\nDate: ${m.date}\nSubject: ${m.subject}\nTo: ${m.to}\n\n${text}\n`
      openComposer('Forward')
      composer.to.focus()
    }

    document.getElementById('composeBtn').addEventListener('click', () => {
      resetComposer(); openComposer('New message'); composer.to.focus()
    })
    document.getElementById('composerClose').addEventListener('click', closeComposer)
    composer.modal.addEventListener('click', (e) => { if (e.target === composer.modal) closeComposer() })

    composer.sendBtn.addEventListener('click', async () => {
      composer.error.style.display = 'none'
      const to = parseList(composer.to.value)
      const cc = parseList(composer.cc.value)
      const bcc = parseList(composer.bcc.value)
      if (to.length === 0 && cc.length === 0 && bcc.length === 0) {
        composer.error.textContent = 'Add at least one recipient.'
        composer.error.style.display = 'block'
        return
      }
      composer.sendBtn.disabled = true
      composer.status.textContent = 'Sending…'
      try {
        const res = await fetch('/webmail/api/compose', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Origin': window.location.origin },
          body: JSON.stringify({
            to, cc, bcc,
            subject: composer.subject.value,
            text: composer.body.value,
            inReplyTo: composer.inReplyTo,
            references: composer.references,
          }),
        })
        if (res.ok) {
          const j = await res.json().catch(() => ({}))
          if (j.ok === false && j.failed && j.failed.length) {
            // Partial failure: some recipients didn't get it. Keep the composer
            // open and tell the user exactly who failed.
            composer.error.textContent = 'Could not deliver to: ' + j.failed.join(', ')
            composer.error.style.display = 'block'
            composer.status.textContent = ''
          } else {
            composer.status.textContent = 'Sent ✓'
            setTimeout(() => { closeComposer(); if (state.folder === 'Sent') loadMessages(); loadFolders() }, 600)
          }
        } else if (res.status === 400) {
          const j = await res.json().catch(() => ({}))
          composer.error.textContent = j.message || 'Invalid message.'
          composer.error.style.display = 'block'
          composer.status.textContent = ''
        } else {
          composer.error.textContent = 'Send failed. Please try again.'
          composer.error.style.display = 'block'
          composer.status.textContent = ''
        }
      } catch (_e) {
        composer.error.textContent = 'Could not reach the server.'
        composer.error.style.display = 'block'
        composer.status.textContent = ''
      } finally {
        composer.sendBtn.disabled = false
      }
    })

    init()
  </script>
</body>
</html>
