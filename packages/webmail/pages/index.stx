<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mail</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<script client>
const user = state(null)
const folders = state([])
const folder = state('INBOX')
const messages = state([])
const selected = state(null)
const loading = state(false)
const reading = state(false)
const error = state('')
const notice = state('')
const query = state('')
const page = state(1)
const total = state(0)
const visible = derived(() => messages().filter(m => [m.from, m.subject, m.snippet].join(' ').toLowerCase().includes(query().toLowerCase())))
const composing = state(false)
const title = state('New message')
const to = state('')
const cc = state('')
const bcc = state('')
const subject = state('')
const body = state('')
const inReplyTo = state('')
const references = state('')
const sending = state(false)
const composeError = state('')
const settings = state(false)
const currentPassword = state('')
const newPassword = state('')
const confirmPassword = state('')
const passwordError = state('')
const saving = state(false)
let listRequest = 0
let messageRequest = 0
async function api(path, options = {}) {
  const response = await fetch(path, { credentials: 'same-origin', ...options })
  if (response.status === 401) { navigate('/login', { reload: true }); throw new Error('Please sign in again.') }
  if (!response.ok) {
    const result = await response.json().catch(() => ({}))
    throw new Error(result.message || 'The request failed. Please try again.')
  }
  return response.json()
}
function messagePath(uid) { return '/webmail/api/messages/' + uid + '?folder=' + encodeURIComponent(folder()) }
async function loadFolders() { folders.set(await api('/webmail/api/folders')) }
async function loadMessages() {
  const request = ++listRequest
  const activeFolder = folder()
  loading.set(true); error.set('')
  try {
    const result = await api('/webmail/api/messages?folder=' + encodeURIComponent(activeFolder) + '&page=' + page() + '&per_page=50')
    if (request !== listRequest) return
    messages.set(result.items || []); total.set(result.total || 0)
  }
  catch (cause) { if (request === listRequest) error.set(cause.message) }
  finally { if (request === listRequest) loading.set(false) }
}
async function refresh() {
  await loadMessages()
  try { await loadFolders() } catch (cause) { error.set(cause.message) }
}
async function selectFolder(name) {
  folder.set(name); page.set(1); query.set(''); selected.set(null); reading.set(false); ++messageRequest
  await refresh()
}
async function turnPage(delta) { page.update(value => value + delta); selected.set(null); ++messageRequest; await loadMessages() }
async function openMessage(uid) {
  const request = ++messageRequest
  const path = messagePath(uid)
  reading.set(true); selected.set(null); error.set('')
  try {
    const message = await api(path)
    if (request !== messageRequest) return
    selected.set(message)
    if (!message.flags?.seen) {
      await api(path, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ flags: { ...message.flags, seen: true } }) })
      if (request === messageRequest) selected.set({ ...message, flags: { ...message.flags, seen: true } })
      await refresh()
    }
  }
  catch (cause) { if (request === messageRequest) error.set(cause.message) }
}
async function setFlag(name, value) {
  const message = selected()
  if (!message) return
  try {
    const flags = { ...message.flags, [name]: value }
    await api(messagePath(message.uid), { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ flags }) })
    selected.set({ ...message, flags }); await refresh()
  }
  catch (cause) { error.set(cause.message) }
}
async function deleteMessage() {
  const message = selected()
  if (!message) return
  try {
    await api(messagePath(message.uid), { method: 'DELETE' })
    selected.set(null); reading.set(false); await refresh()
  }
  catch (cause) { error.set(cause.message) }
}
function bareAddress(value) { const match = /<([^>]+)>/.exec(value || ''); return (match ? match[1] : value || '').trim() }
function addresses(value) { return value.split(',').map(bareAddress).filter(Boolean) }
function compose(mode = 'new') {
  const message = selected()
  to.set(''); cc.set(''); bcc.set(''); subject.set(''); body.set(''); inReplyTo.set(''); references.set(''); composeError.set('')
  title.set(mode === 'new' ? 'New message' : mode === 'forward' ? 'Forward' : mode === 'all' ? 'Reply all' : 'Reply')
  if (message && mode !== 'new') {
    const text = message.text || '[HTML message]'
    subject.set((mode === 'forward' ? 'Fwd: ' : /^re:/i.test(message.subject || '') ? '' : 'Re: ') + (message.subject || ''))
    if (mode === 'forward') body.set('\n\n---------- Forwarded message ----------\nFrom: ' + message.from + '\nDate: ' + message.date + '\nSubject: ' + message.subject + '\n\n' + text)
    else {
      to.set(bareAddress(message.from))
      if (mode === 'all') cc.set([...new Set([...addresses(message.to || ''), ...addresses(message.cc || '')])].filter(a => a.toLowerCase() !== user().email.toLowerCase() && a !== bareAddress(message.from)).join(', '))
      body.set('\n\nOn ' + message.date + ', ' + message.from + ' wrote:\n' + text.split('\n').map(line => '> ' + line).join('\n'))
      inReplyTo.set(message.message_id || ''); references.set(message.message_id || '')
    }
  }
  composing.set(true)
}
async function send() {
  if (sending()) return
  composeError.set('')
  if (!addresses(to()).length && !addresses(cc()).length && !addresses(bcc()).length) { composeError.set('Add at least one recipient.'); return }
  sending.set(true)
  try {
    const result = await api('/webmail/api/compose', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ to: addresses(to()), cc: addresses(cc()), bcc: addresses(bcc()), subject: subject(), text: body(), inReplyTo: inReplyTo(), references: references() }) })
    if (result.ok === false) { composeError.set('Could not deliver to: ' + (result.failed || []).join(', ')); return }
    composing.set(false); notice.set('Message sent.'); await refresh()
  }
  catch (cause) { composeError.set(cause.message) }
  finally { sending.set(false) }
}
async function signOut() {
  try { await api('/webmail/auth/logout', { method: 'POST' }); navigate('/login', { reload: true }) }
  catch (cause) { error.set(cause.message) }
}
async function changePassword() {
  if (saving()) return
  passwordError.set('')
  if (newPassword() !== confirmPassword()) { passwordError.set('The new passwords do not match.'); return }
  if (newPassword().length < 12) { passwordError.set('Use at least 12 characters.'); return }
  saving.set(true)
  try {
    await api('/webmail/auth/password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ currentPassword: currentPassword(), newPassword: newPassword() }) })
    currentPassword.set(''); newPassword.set(''); confirmPassword.set(''); navigate('/login', { reload: true })
  }
  catch (cause) { passwordError.set(cause.message) }
  finally { saving.set(false) }
}
function shortDate(value) { const date = new Date(value); return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString([], { month: 'short', day: 'numeric' }) }
function safeHtml(html) { return '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src data:; style-src \'unsafe-inline\'">' + html }
onMount(async () => {
  try { const result = await api('/webmail/auth/me'); user.set(result.user); await refresh() }
  catch (cause) { error.set(cause.message) }
})
</script>
<p :if="!user" class="wm-state" role="status" :text="error || 'Opening your inbox…'"></p>
<div :if="user" class="wm" :class="{ 'wm--reading': reading }">
  <aside class="wm-folders">
    <div class="text-indigo-600 wm-brand">Mail</div>
    <button class="wm-compose-btn" @click="compose()">Compose</button>
    <nav class="wm-folder-list" aria-label="Mail folders">
      <button :for="item in folders" class="wm-folder" :class="{ 'wm-folder--active': item.name === folder }" @click="selectFolder(item.name)">
        <span :text="item.name"></span><span :if="item.unread > 0" class="wm-folder-count" :text="item.unread"></span>
      </button>
    </nav>
    <div class="wm-user">
      <span class="wm-user-email" :text="user?.email"></span>
      <button class="mb-2 wm-logout" @click="settings.set(true)">Change password</button>
      <button class="wm-logout" @click="signOut()">Sign out</button>
    </div>
  </aside>
  <section class="wm-list" aria-label="Messages">
    <header class="wm-list-head"><span class="wm-list-title" :text="folder"></span><button class="wm-refresh" @click="refresh()" :disabled="loading" aria-label="Refresh messages">Refresh</button></header>
    <input class="wm-search" type="search" x-model="query" placeholder="Search this page" aria-label="Search messages">
    <p :if="error" class="login-error" role="alert" :text="error"></p>
    <p :if="notice" class="px-4 text-indigo-600" role="status" :text="notice"></p>
    <div class="wm-list-body" :aria-busy="loading">
      <p :if="loading" class="wm-state">Loading messages…</p>
      <p :if="!loading && visible.length === 0" class="wm-state">No messages in this folder.</p>
      <button :for="message in visible" class="wm-msg" :class="{ 'wm-msg--active': message.uid === selected?.uid, 'wm-msg--unread': !message.flags?.seen }" @click="openMessage(message.uid)">
        <span class="wm-msg-row"><span class="wm-msg-from" :text="message.from"></span><span class="wm-msg-date" :text="shortDate(message.date)"></span></span>
        <span class="wm-msg-subject" :text="(message.flags?.flagged ? '★ ' : '') + (message.subject || '(no subject)')"></span>
        <span class="wm-msg-snippet" :text="message.snippet"></span>
      </button>
    </div>
    <footer class="flex items-center justify-between p-3 border-gray-200 border-t">
      <button @click="turnPage(-1)" :disabled="page <= 1 || loading">Previous</button>
      <span :text="'Page ' + page + ' · ' + total + ' messages'"></span>
      <button @click="turnPage(1)" :disabled="page * 50 >= total || loading">Next</button>
    </footer>
  </section>
  <section class="wm-read" aria-label="Message reader">
    <button class="wm-back" @click="reading.set(false)">Back to messages</button>
    <p :if="!selected" class="wm-state">Select a message to read.</p>
    <article :if="selected" class="wm-read-body">
      <div class="wm-read-toolbar">
        <button class="wm-action" @click="compose('reply')">Reply</button><button class="wm-action" @click="compose('all')">Reply all</button><button class="wm-action" @click="compose('forward')">Forward</button>
        <button class="wm-action" @click="setFlag('flagged', !selected.flags?.flagged)" :text="selected.flags?.flagged ? 'Unflag' : 'Flag'"></button>
        <button class="wm-action" @click="setFlag('seen', false)">Mark unread</button><button class="wm-action wm-action--danger" @click="deleteMessage()" :text="folder === 'Trash' ? 'Delete permanently' : 'Move to Trash'"></button>
      </div>
      <h2 class="wm-read-subject" :text="selected.subject || '(no subject)'"></h2>
      <div class="wm-read-meta"><div><span class="wm-read-label">From</span><span :text="selected.from"></span></div><div><span class="wm-read-label">To</span><span :text="selected.to"></span></div><div :if="selected.cc"><span class="wm-read-label">Cc</span><span :text="selected.cc"></span></div><div><span class="wm-read-label">Date</span><span :text="selected.date"></span></div></div>
      <div class="wm-read-attach"><span :for="attachment in (selected.attachments || [])" class="wm-attach-chip" :text="attachment.filename"></span></div>
      <iframe :if="selected.html" class="wm-read-html" sandbox="" referrerpolicy="no-referrer" title="Email content" :srcdoc="safeHtml(selected.html)"></iframe>
      <pre :if="!selected.html" class="wm-read-text" :text="selected.text"></pre>
    </article>
  </section>
</div>
<div :if="composing" class="wm-modal" role="dialog" aria-modal="true" aria-label="Compose message">
  <form class="wm-composer" @submit.prevent="send()">
    <header class="wm-composer-head"><span :text="title"></span><button type="button" class="wm-composer-close" @click="composing.set(false)" :disabled="sending" aria-label="Close composer">Close</button></header>
    <div class="wm-composer-fields"><label>To<input type="text" x-model="to" placeholder="recipient@example.com"></label><label>Cc<input type="text" x-model="cc"></label><label>Bcc<input type="text" x-model="bcc"></label><label>Subject<input type="text" x-model="subject"></label></div>
    <textarea class="wm-composer-body" x-model="body" aria-label="Message body" placeholder="Write your message…"></textarea>
    <p :if="composeError" class="wm-composer-error" role="alert" :text="composeError"></p>
    <footer class="wm-composer-foot"><button class="wm-send-btn" type="submit" :disabled="sending" :text="sending ? 'Sending…' : 'Send'"></button></footer>
  </form>
</div>
<div :if="settings" class="wm-modal" role="dialog" aria-modal="true" aria-label="Change password">
  <form class="login" @submit.prevent="changePassword()">
    <h1>Change password</h1><p class="login-sub">This updates your webmail, IMAP and SMTP password. You’ll sign in again afterward.</p>
    <label for="currentPassword">Current password</label><input id="currentPassword" type="password" x-model="currentPassword" autocomplete="current-password" required>
    <label for="newPassword">New password</label><input id="newPassword" type="password" x-model="newPassword" autocomplete="new-password" minlength="12" required>
    <label for="confirmPassword">Confirm password</label><input id="confirmPassword" type="password" x-model="confirmPassword" autocomplete="new-password" minlength="12" required>
    <p :if="passwordError" class="login-error" role="alert" :text="passwordError"></p>
    <button type="submit" :disabled="saving" :text="saving ? 'Saving…' : 'Save password'"></button><button type="button" @click="settings.set(false)" :disabled="saving">Cancel</button>
  </form>
</div>
<noscript>JavaScript is required to use webmail.</noscript>
</body>
</html>
