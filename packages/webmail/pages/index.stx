<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mail</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<script client>
import { useWebmail } from '../functions/use-webmail'
const ready = state(false)
const mail = useWebmail({
  composer: useRef('composerDialog'), password: useRef('passwordDialog'),
  confirmation: useRef('confirmDialog'), fileInput: useRef('fileInput'),
  selectAll: useRef('selectAll'), navigate, nextTick,
})
const {
  user, folders, folder, messages, threads, expandedThreads, selected, loading, reading, readingLoading,
  mutating, error, notice, query, searchAll, filterSender, filterAfter, filterBefore, filterUnread,
  filterFlagged, filterAttachments, filtersOpen, filterActive, conversations, page, total, matchingTotal,
  moveTo, showHtml, checkedKeys, selectedCount, allChecked, someChecked, undoAction, undoRemaining,
  pendingSend, sendRemaining, outbox, outboxCount, outboxView, cancelling, authExpired, currentFolderName, now,
  composing, title, subject, body, showCc, showBcc, sending, sendUncertain, composeError, hasComposition, saveStatus,
  savingDraft, draftError, draftConflict, sendDelay, sendDelayOptions, settings, currentPassword, newPassword,
  confirmPassword, passwordError, savingPassword, confirmation, confirming, limits,
  toRecipients, ccRecipients, bccRecipients, toInput, ccInput, bccInput, recipientFocus, suggestions,
  suggestionIndex, recipientSearching, recipientErrors, lookup, chooseContact, removeRecipient,
  editRecipient, recipientKeydown, recipientBlur, attachments, dragging, attachmentBytes,
  attachmentRemaining, attachmentPending, attachmentUploading, removeAttachment, retryAttachment,
  refresh, selectFolder, search, clearSearch, changeConversationView, turnPage, toggleThread,
  toggleSelection, toggleAll, toggleThreadSelection, threadChecked, threadPartial, clearSelection, openMessage, closeReader, bulkAction, selectedAction,
  undoLastAction, compose, closeComposer, editDraft, saveDraft, attachFiles, dropAttachments,
  saveSendPreference, send, confirmPendingSend, showOutbox, cancelSend, retryOutbox, signOut, showSettings, changePassword,
  showConfirmation, confirmAction, saveDraftCopy, resume, tick, preventUnload,
  messageKey, folderName, shortDate, fullDate, readableBytes, safeHtml, attachmentPath,
} = mail
async function boot() { ready.set(false); await mail.mount(); ready.set(true) }
useInterval(() => tick(), 1000, { whileVisible: true })
useEventListener('beforeunload', preventUnload)
useEventListener('online', resume)
useEventListener('focus', resume)
onMount(boot)
onUnmounted(() => mail.destroy())
</script>
<main :if="!ready || !user" class="wm-boot"><p role="status" :text="error || 'Opening your inbox…'"></p><button :if="error" @click="boot()">Retry connection</button></main>
<div :if="ready && user" class="wm" :class="{ 'wm--reading': reading }">
  <aside class="wm-folders">
    <div class="wm-brand font-semibold text-indigo-600">Mail</div>
    <button class="wm-compose-btn" @click="compose()" :disabled="sending || sendUncertain" :text="hasComposition ? 'Resume draft' : 'Compose'"></button>
    <nav class="wm-folder-list" aria-label="Mail folders">
      <button :for="item in folders" class="wm-folder" :class="{ 'wm-folder--active': !outboxView && item.name === folder }" @click="selectFolder(item.name)" :disabled="mutating" :aria-current="!outboxView && item.name === folder ? 'page' : null">
        <span :text="folderName(item.name)"></span><span :if="(item.name === 'Drafts' ? item.total : item.unread) > 0" class="wm-folder-count" :text="item.name === 'Drafts' ? item.total : item.unread"></span>
      </button>
      <button class="wm-folder" :class="{ 'wm-folder--active': !outboxView && folder === '*' }" @click="selectFolder('*')" :disabled="mutating">All mail</button>
      <button class="wm-folder" :class="{ 'wm-folder--active': outboxView }" @click="showOutbox()"><span>Outbox</span><span :if="outboxCount > 0" class="wm-folder-count" :text="outboxCount"></span></button>
    </nav>
    <div class="wm-user"><span class="wm-user-email" :text="user?.email"></span><button class="wm-logout" @click="showSettings()">Change password</button><button class="wm-logout" @click="signOut()" :disabled="sending || savingDraft">Sign out</button></div>
  </aside>
  <section class="wm-workspace">
    <div :if="authExpired" class="wm-session" role="alert">Your session expired. <a href="/login" target="_blank" rel="noopener">Sign in again</a>, then return here to save your changes.</div>
    <div :if="notice" class="wm-notice" role="status"><span :text="notice"></span><button :if="undoAction && undoRemaining > 0" class="wm-action" @click="undoLastAction()" :disabled="mutating" aria-label="Undo last action">Undo <span aria-hidden="true" :text="'(' + undoRemaining + 's)' "></span></button><button :if="pendingSend?.state === 'pending' && sendRemaining > 0" class="wm-action" @click="cancelSend()" :disabled="cancelling" aria-label="Undo send">Undo Send <span aria-hidden="true" :text="'(' + sendRemaining + 's)' "></span></button></div>
    <div class="wm-columns">
    <section :if="!outboxView" class="wm-list" aria-label="Messages">
      <header class="wm-list-head"><h1 class="wm-list-title" :text="currentFolderName"></h1><button class="wm-refresh" @click="refresh()" :disabled="loading" aria-label="Refresh messages">Refresh</button></header>
      <form class="wm-search-form" role="search" @submit.prevent="search()">
        <div class="wm-search-row"><input type="search" class="wm-search" x-model="query" maxlength="256" :placeholder="searchAll ? 'Search all folders' : 'Search this folder'" aria-label="Search messages"><button class="wm-action" type="submit" :disabled="loading">Search</button><button class="wm-action" type="button" @click="filtersOpen.set(!filtersOpen())" :aria-expanded="filtersOpen" aria-controls="mailFilters">Filters</button></div>
        <div :if="filtersOpen" id="mailFilters" class="wm-filter-panel">
          <label>Sender<input type="text" x-model="filterSender" maxlength="256" placeholder="Name or email" aria-label="Filter by sender"></label>
          <div class="wm-filter-dates"><label>After<input type="date" x-model="filterAfter" aria-label="After date"></label><label>Before<input type="date" x-model="filterBefore" aria-label="Before date"></label></div>
          <div class="wm-filter-checks"><label><input type="checkbox" x-model="filterUnread">Unread</label><label><input type="checkbox" x-model="filterFlagged">Flagged</label><label><input type="checkbox" x-model="filterAttachments">Has attachments</label><label><input type="checkbox" x-model="searchAll">All folders</label></div>
          <button class="wm-action" type="submit" :disabled="loading">Apply filters</button>
        </div>
        <button :if="filterActive" class="wm-clear-search" type="button" @click="clearSearch()">Clear search and filters</button>
      </form>
      <div class="wm-list-options"><label :if="folder !== 'Drafts'"><input type="checkbox" x-model="conversations" @change="changeConversationView()">Conversations</label><span :text="matchingTotal + (matchingTotal === 1 ? ' message' : ' messages')"></span></div>
      <div class="wm-selection-bar"><label class="wm-select-all"><input ref="selectAll" type="checkbox" :checked="allChecked" :aria-checked="someChecked ? 'mixed' : allChecked ? 'true' : 'false'" @change="toggleAll()" :disabled="loading || mutating" aria-label="Select messages on this page"><span :text="selectedCount ? selectedCount + ' selected' : 'Select messages'"></span></label><button :if="selectedCount > 0" class="wm-clear-search" @click="clearSelection()">Clear</button></div>
      <div :if="selectedCount > 0" class="wm-bulk-toolbar" aria-label="Selected message actions">
        <button class="wm-action" @click="bulkAction('move', 'Archive')" :disabled="mutating">Archive</button><button class="wm-action" @click="bulkAction('move')" :disabled="mutating">Move</button><select x-model="moveTo" :disabled="mutating" aria-label="Bulk move destination"><option :for="item in folders" :value="item.name" :text="folderName(item.name)"></option></select>
        <button class="wm-action" @click="bulkAction('read')" :disabled="mutating">Mark read</button><button class="wm-action" @click="bulkAction('unread')" :disabled="mutating">Mark unread</button><button class="wm-action" @click="bulkAction('flag')" :disabled="mutating">Flag</button>
        <button class="wm-action wm-action--danger" @click="bulkAction(folder() === 'Trash' ? 'purge' : 'trash')" :disabled="mutating" :text="folder === 'Trash' ? 'Delete permanently' : 'Trash'"></button>
      </div>
      <p :if="error" class="login-error" role="alert" :text="error"></p>
      <div class="wm-list-body" :aria-busy="loading">
        <p :if="loading" class="wm-state" role="status">Loading messages…</p>
        <p :if="!loading && total === 0" class="wm-state" role="status" :text="filterActive ? 'No messages match your search.' : 'No messages in this folder.'"></p>
        <div :for="thread in threads" class="wm-thread">
          <div class="wm-message-row" :class="{ 'wm-message-row--unread': thread.unread > 0 }">
            <input class="wm-message-check" type="checkbox" :checked="threadChecked(thread)" :aria-checked="threadPartial(thread) ? 'mixed' : threadChecked(thread) ? 'true' : 'false'" @click.stop.prevent="toggleThreadSelection(thread, $event)" :disabled="mutating" :aria-label="'Select conversation: ' + (thread.latest.subject || '(no subject)')">
            <button class="wm-msg" @click="thread.count > 1 ? toggleThread(thread.id) : openMessage(thread.latest)" :aria-expanded="thread.count > 1 ? expandedThreads.includes(thread.id) : null" :disabled="mutating">
              <span class="wm-msg-row"><span class="wm-msg-from" :text="thread.latest.from"></span><span class="wm-msg-date" :title="fullDate(thread.latest.date)" :text="shortDate(thread.latest.date)"></span></span>
              <span class="wm-msg-subject"><span :text="(thread.latest.flags?.flagged ? '★ ' : '') + (thread.latest.has_attachments ? '📎 ' : '') + (thread.latest.subject || '(no subject)')"></span><span :if="thread.count > 1" class="wm-thread-count" :text="thread.count"></span></span>
              <span class="wm-msg-snippet" :text="thread.latest.snippet"></span>
            </button>
          </div>
          <div :if="thread.count > 1 && expandedThreads.includes(thread.id)" class="wm-thread-members">
            <div :for="message in thread.members" class="wm-message-row" :class="{ 'wm-message-row--active': selected && messageKey(message) === messageKey(selected), 'wm-message-row--unread': !message.flags.seen }">
              <input class="wm-message-check" type="checkbox" :checked="checkedKeys.includes(messageKey(message))" @click.stop.prevent="toggleSelection(message, $event)" :disabled="mutating" :aria-label="'Select message: ' + (message.subject || '(no subject)')">
              <button class="wm-msg" @click="openMessage(message)" :disabled="mutating"><span class="wm-msg-row"><span class="wm-msg-from" :text="message.from"></span><span class="wm-msg-date" :text="shortDate(message.date)"></span></span><span class="wm-msg-subject" :text="message.subject || '(no subject)'"></span><span :if="searchAll" class="wm-folder-badge" :text="folderName(message.folder)"></span><span class="wm-msg-snippet" :text="message.snippet"></span></button>
            </div>
          </div>
        </div>
        <div :for="message in messages" class="wm-message-row" :class="{ 'wm-message-row--active': selected && messageKey(message) === messageKey(selected), 'wm-message-row--unread': !message.flags.seen }">
          <input class="wm-message-check" type="checkbox" :checked="checkedKeys.includes(messageKey(message))" @click.stop.prevent="toggleSelection(message, $event)" :disabled="mutating" :aria-label="'Select message: ' + (message.subject || '(no subject)')">
          <button class="wm-msg" @click="openMessage(message)" :disabled="mutating"><span class="wm-msg-row"><span class="wm-msg-from" :text="message.from"></span><span class="wm-msg-date" :title="fullDate(message.date)" :text="shortDate(message.date)"></span></span><span class="wm-msg-subject" :text="(message.flags.flagged ? '★ ' : '') + (message.has_attachments ? '📎 ' : '') + (message.flags.answered ? '↩ ' : '') + (message.subject || '(no subject)')"></span><span :if="searchAll" class="wm-folder-badge" :text="folderName(message.folder)"></span><span class="wm-msg-snippet" :text="message.snippet"></span></button>
        </div>
      </div>
      <footer class="wm-pagination"><button @click="turnPage(-1)" :disabled="page <= 1 || loading || mutating">Previous</button><span :text="'Page ' + page + ' of ' + Math.max(1, Math.ceil(total / 50))"></span><button @click="turnPage(1)" :disabled="page * 50 >= total || loading || mutating">Next</button></footer>
    </section>
    <section :if="!outboxView" class="wm-read" aria-label="Message reader">
      <button class="wm-back" @click="reading.set(false)" :disabled="mutating">Back to messages</button>
      <p :if="!selected" class="wm-state" role="status" :text="readingLoading ? 'Opening message…' : 'Select a message to read.'"></p>
      <article :if="selected" class="wm-read-body">
        <div class="wm-read-toolbar" :aria-busy="mutating">
          <button :if="selected?.folder === 'Drafts'" class="wm-action" @click="editDraft()" :disabled="mutating">Edit draft</button>
          <button :if="selected?.folder !== 'Drafts'" class="wm-action" @click="compose('reply')" :disabled="mutating">Reply</button><button :if="selected?.folder !== 'Drafts'" class="wm-action" @click="compose('all')" :disabled="mutating">Reply all</button><button :if="selected?.folder !== 'Drafts'" class="wm-action" @click="compose('forward')" :disabled="mutating">Forward</button>
          <button class="wm-action" @click="selectedAction(selected?.flags?.flagged ? 'unflag' : 'flag')" :disabled="mutating" :text="selected?.flags?.flagged ? 'Unflag' : 'Flag'"></button><button class="wm-action" @click="selectedAction('unread')" :disabled="mutating">Mark unread</button><button class="wm-action" @click="selectedAction('move')" :disabled="mutating">Move</button><select x-model="moveTo" :disabled="mutating" aria-label="Move destination"><option :for="item in folders" :value="item.name" :text="folderName(item.name)"></option></select><button class="wm-action wm-action--danger" @click="selectedAction(selected?.folder === 'Trash' ? 'purge' : 'trash')" :disabled="mutating" :text="selected?.folder === 'Trash' ? 'Delete permanently' : 'Trash'"></button>
        </div>
        <span class="wm-folder-badge" :text="folderName(selected?.folder || '')"></span><h2 class="wm-read-subject" :text="selected?.subject || '(no subject)'"></h2>
        <div class="wm-read-meta"><div><span class="wm-read-label">From</span><span :text="selected?.from"></span></div><div><span class="wm-read-label">To</span><span :text="selected?.to"></span></div><div :if="selected?.cc"><span class="wm-read-label">Cc</span><span :text="selected?.cc"></span></div><div :if="selected?.bcc"><span class="wm-read-label">Bcc</span><span :text="selected?.bcc"></span></div><div :if="selected?.reply_to"><span class="wm-read-label">Reply to</span><span :text="selected?.reply_to"></span></div><div><span class="wm-read-label">Date</span><span :text="fullDate(selected?.date || '')"></span></div></div>
        <div class="wm-read-attach"><a :for="(attachment, index) in (selected?.attachments || [])" class="wm-attach-chip" :href="attachmentPath(index)" :download="attachment.filename" :text="attachment.filename + ' · ' + readableBytes(attachment.size)"></a></div>
        <div :if="selected?.html" class="wm-format-control"><button class="wm-action" @click="showHtml.set(!showHtml())" :text="showHtml ? 'Show plain text' : 'Show formatted email'"></button><span>Remote images are blocked.</span></div>
        <iframe :if="selected?.html && showHtml" class="wm-read-html" sandbox="" referrerpolicy="no-referrer" title="Email content" :srcdoc="safeHtml(selected?.html || '')"></iframe><pre :if="!selected?.html || !showHtml" class="wm-read-text" :text="selected?.text || 'No plain-text version is available.'"></pre>
      </article>
    </section>
    <section :if="outboxView" class="wm-outbox" aria-label="Outbox"><header class="wm-list-head"><h1>Outbox</h1><p>Messages wait here during the Undo Send window.</p></header><p :if="error" role="alert" class="login-error" :text="error"></p><p :if="outbox.length === 0" class="wm-state">No queued messages.</p>
      <article :for="item in outbox" class="wm-outbox-item"><div><h2 :text="item.message.subject || '(no subject)'"></h2><p :text="item.message.to.join(', ')"></p><span class="wm-outbox-status" :text="item.state === 'pending' ? 'Waiting to send' : item.state === 'sending' ? 'Sending…' : item.state === 'sent' ? 'Delivered' : item.state === 'cancelled' ? 'Cancelled' : item.state === 'partial' ? 'Partially delivered' : item.state === 'sent_unfiled' ? 'Delivered; Sent copy unavailable' : item.state === 'unknown' ? 'Check Sent before retrying' : 'Delivery failed'"></span><p :if="item.error" :text="item.error"></p><p :if="item.result?.failed?.length" :text="'Unsent recipients: ' + item.result.failed.join(', ')"></p></div><button :if="item.state === 'pending' && item.dueAt > now" class="wm-action" @click="cancelSend(item.id)" :disabled="cancelling">Undo Send</button><button :if="['failed', 'partial', 'cancelled', 'unknown'].includes(item.state)" class="wm-action" @click="retryOutbox(item.id)">Review and retry</button><button :if="item.state === 'unknown' || item.state === 'sent_unfiled'" class="wm-action" @click="selectFolder('Sent')">Check Sent</button></article>
    </section>
    </div>
  </section>
</div>
<dialog :if="composing" ref="composerDialog" class="wm-modal" aria-label="Compose message" @cancel.prevent="closeComposer()">
  <form class="wm-composer" @submit.prevent="send()">
    <header class="wm-composer-head"><span :text="title"></span><button type="button" class="wm-composer-close" @click="closeComposer()" :disabled="sending || savingDraft" aria-label="Close composer">Close</button></header>
    <div class="wm-composer-fields">
      <div class="wm-recipient-field"><label for="recipient-to">To</label><div class="wm-recipient-box" :class="{ 'wm-recipient-box--invalid': toRecipients.some(item => !item.valid) }">
        <div :for="(item, index) in toRecipients" class="wm-recipient-chip" :class="{ 'wm-recipient-chip--invalid': !item.valid }"><button type="button" @click="editRecipient('to', index)" :disabled="sending || sendUncertain" :title="item.address" :text="item.name || item.address || item.raw"></button><button type="button" @click="removeRecipient('to', index)" :disabled="sending || sendUncertain" :aria-label="'Remove recipient ' + item.address">×</button></div>
        <input id="recipient-to" autofocus type="text" x-model="toInput" @input="lookup('to')" @focus="lookup('to')" @keydown="recipientKeydown($event, 'to')" @blur="recipientBlur($event, 'to')" :disabled="sending || sendUncertain" autocomplete="off" role="combobox" aria-autocomplete="list" :aria-expanded="recipientFocus === 'to' && suggestions.length > 0" aria-controls="contacts-to" :aria-activedescendant="recipientFocus === 'to' && suggestionIndex >= 0 ? 'contact-to-' + suggestionIndex : null" placeholder="Add a recipient" aria-label="To" :aria-invalid="toRecipients.some(item => !item.valid)">
        <div :if="recipientFocus === 'to' && suggestions.length > 0" id="contacts-to" class="wm-recipient-suggestions" role="listbox" aria-label="Recent contacts"><button :for="(contact, index) in suggestions" :id="'contact-to-' + index" type="button" role="option" :aria-selected="suggestionIndex === index" data-recipient-suggestion @mousedown.prevent="void 0" @click="chooseContact('to', contact)"><span :text="contact.name || contact.address"></span><small :text="contact.address"></small></button></div>
      </div></div>
      <div :if="showCc" class="wm-recipient-field"><label for="recipient-cc">Cc</label><div class="wm-recipient-box" :class="{ 'wm-recipient-box--invalid': ccRecipients.some(item => !item.valid) }">
        <div :for="(item, index) in ccRecipients" class="wm-recipient-chip" :class="{ 'wm-recipient-chip--invalid': !item.valid }"><button type="button" @click="editRecipient('cc', index)" :disabled="sending || sendUncertain" :title="item.address" :text="item.name || item.address || item.raw"></button><button type="button" @click="removeRecipient('cc', index)" :disabled="sending || sendUncertain" :aria-label="'Remove recipient ' + item.address">×</button></div>
        <input id="recipient-cc" type="text" x-model="ccInput" @input="lookup('cc')" @focus="lookup('cc')" @keydown="recipientKeydown($event, 'cc')" @blur="recipientBlur($event, 'cc')" :disabled="sending || sendUncertain" autocomplete="off" role="combobox" aria-autocomplete="list" :aria-expanded="recipientFocus === 'cc' && suggestions.length > 0" aria-controls="contacts-cc" :aria-activedescendant="recipientFocus === 'cc' && suggestionIndex >= 0 ? 'contact-cc-' + suggestionIndex : null" placeholder="Add a recipient" aria-label="Cc" :aria-invalid="ccRecipients.some(item => !item.valid)">
        <div :if="recipientFocus === 'cc' && suggestions.length > 0" id="contacts-cc" class="wm-recipient-suggestions" role="listbox" aria-label="Recent contacts"><button :for="(contact, index) in suggestions" :id="'contact-cc-' + index" type="button" role="option" :aria-selected="suggestionIndex === index" data-recipient-suggestion @mousedown.prevent="void 0" @click="chooseContact('cc', contact)"><span :text="contact.name || contact.address"></span><small :text="contact.address"></small></button></div>
      </div></div>
      <div :if="showBcc" class="wm-recipient-field"><label for="recipient-bcc">Bcc</label><div class="wm-recipient-box" :class="{ 'wm-recipient-box--invalid': bccRecipients.some(item => !item.valid) }">
        <div :for="(item, index) in bccRecipients" class="wm-recipient-chip" :class="{ 'wm-recipient-chip--invalid': !item.valid }"><button type="button" @click="editRecipient('bcc', index)" :disabled="sending || sendUncertain" :title="item.address" :text="item.name || item.address || item.raw"></button><button type="button" @click="removeRecipient('bcc', index)" :disabled="sending || sendUncertain" :aria-label="'Remove recipient ' + item.address">×</button></div>
        <input id="recipient-bcc" type="text" x-model="bccInput" @input="lookup('bcc')" @focus="lookup('bcc')" @keydown="recipientKeydown($event, 'bcc')" @blur="recipientBlur($event, 'bcc')" :disabled="sending || sendUncertain" autocomplete="off" role="combobox" aria-autocomplete="list" :aria-expanded="recipientFocus === 'bcc' && suggestions.length > 0" aria-controls="contacts-bcc" :aria-activedescendant="recipientFocus === 'bcc' && suggestionIndex >= 0 ? 'contact-bcc-' + suggestionIndex : null" placeholder="Add a recipient" aria-label="Bcc" :aria-invalid="bccRecipients.some(item => !item.valid)">
        <div :if="recipientFocus === 'bcc' && suggestions.length > 0" id="contacts-bcc" class="wm-recipient-suggestions" role="listbox" aria-label="Recent contacts"><button :for="(contact, index) in suggestions" :id="'contact-bcc-' + index" type="button" role="option" :aria-selected="suggestionIndex === index" data-recipient-suggestion @mousedown.prevent="void 0" @click="chooseContact('bcc', contact)"><span :text="contact.name || contact.address"></span><small :text="contact.address"></small></button></div>
      </div></div>
      <div class="wm-cc-controls"><button type="button" class="wm-clear-search" @click="showCc.set(!showCc())" :disabled="ccRecipients.length > 0 || !!ccInput" :text="showCc ? 'Hide Cc' : 'Add Cc'"></button><button type="button" class="wm-clear-search" @click="showBcc.set(!showBcc())" :disabled="bccRecipients.length > 0 || !!bccInput" :text="showBcc ? 'Hide Bcc' : 'Add Bcc'"></button><span :if="recipientSearching" aria-hidden="true">Looking for contacts…</span></div>
      <p :if="recipientErrors.length > 0" class="wm-composer-error" role="alert" :text="'Check recipient addresses: ' + recipientErrors.join(', ')"></p>
      <label for="composeSubject">Subject</label><input id="composeSubject" type="text" x-model="subject" :disabled="sending || sendUncertain" maxlength="500">
    </div>
    <textarea class="wm-composer-body" x-model="body" :disabled="sending || sendUncertain" aria-label="Message body" placeholder="Write your message…"></textarea>
    <div class="wm-dropzone" :class="{ 'wm-dropzone--active': dragging }" @dragover.prevent="dragging.set(true)" @dragleave="dragging.set(false)" @drop.prevent="dropAttachments($event)">
      <label class="wm-action">Add attachments<input ref="fileInput" class="wm-file-input" type="file" multiple aria-label="Add attachments" @change="attachFiles()" :disabled="sending || attachmentUploading || limits.maxCount === 0"></label><span>or drop files here</span><small :text="readableBytes(attachmentBytes()) + ' used · ' + readableBytes(attachmentRemaining()) + ' remaining'"></small>
    </div>
    <ul :if="attachments.length" class="wm-compose-attachments"><li :for="attachment in attachments"><div><span :text="attachment.filename + ' · ' + readableBytes(attachment.size)"></span><progress :if="attachment.status === 'uploading'" max="100" :value="attachment.progress" :aria-label="'Uploading ' + attachment.filename"></progress><small :if="attachment.status === 'uploading'" aria-hidden="true" :text="attachment.progress === 100 ? 'Processing…' : attachment.progress + '%' "></small><p :if="attachment.error" class="wm-composer-error" :text="attachment.error"></p></div><button :if="attachment.status === 'failed'" type="button" class="wm-action" @click="retryAttachment(attachment.key)" :disabled="sending || sendUncertain">Retry upload</button><button type="button" class="wm-action" @click="removeAttachment(attachment.key)" :disabled="sending || sendUncertain" :aria-label="'Remove attachment ' + attachment.filename">Remove</button></li></ul>
    <p :if="composeError || draftError" class="wm-composer-error" role="alert" :text="composeError || draftError"></p><div :if="sendUncertain" class="wm-draft-conflict"><button type="button" class="wm-action" @click="confirmPendingSend()" :disabled="sending">Confirm send status</button></div><div :if="draftConflict" class="wm-draft-conflict"><button type="button" class="wm-action" @click="saveDraftCopy()">Save a copy</button><button type="button" class="wm-action" @click="showConfirmation('reload-draft')">Reload saved draft</button></div>
    <div class="wm-draft-status" role="status" aria-live="polite" aria-atomic="true" :text="saveStatus"></div>
    <footer class="wm-composer-foot"><button class="wm-send-btn" type="submit" :disabled="sending || sendUncertain || savingDraft || attachmentPending || draftConflict || authExpired" :text="sending ? 'Queuing…' : 'Send'"></button><button class="wm-action" type="button" @click="saveDraft()" :disabled="sending || savingDraft || attachmentPending" :text="savingDraft ? 'Saving…' : 'Save draft'"></button><button class="wm-action" type="button" @click="showConfirmation('discard')" :disabled="sending || savingDraft">Discard</button><label class="wm-send-delay">Undo Send<select x-model.number="sendDelay" @change="saveSendPreference()" :disabled="sending || sendUncertain"><option :for="value in sendDelayOptions" :value="value" :text="value === 0 ? 'Off' : value + ' seconds'"></option></select></label></footer>
  </form>
</dialog>
<dialog :if="settings" ref="passwordDialog" class="wm-modal wm-password-dialog" aria-label="Change password" @cancel.prevent="settings.set(false)"><form class="login" @submit.prevent="changePassword()"><h1>Change password</h1><p class="login-sub">Updates your webmail, SMTP and IMAP credentials.</p><label for="currentPassword">Current password</label><input id="currentPassword" type="password" x-model="currentPassword" autocomplete="current-password" required autofocus><label for="newPassword">New password</label><input id="newPassword" type="password" x-model="newPassword" autocomplete="new-password" minlength="12" required><label for="confirmPassword">Confirm password</label><input id="confirmPassword" type="password" x-model="confirmPassword" autocomplete="new-password" minlength="12" required><p :if="passwordError" role="alert" class="login-error" :text="passwordError"></p><button type="submit" :disabled="savingPassword" :text="savingPassword ? 'Saving…' : 'Change password'"></button><button type="button" @click="settings.set(false)" :disabled="savingPassword">Cancel</button></form></dialog>
<dialog :if="confirmation" ref="confirmDialog" class="wm-modal wm-confirm-dialog" aria-label="Confirm action" @cancel.prevent="confirmation.set('')"><div class="login"><h1 :text="confirmation === 'purge' ? 'Delete permanently?' : confirmation === 'reload-draft' ? 'Reload saved draft?' : confirmation === 'retry-unknown' ? 'Review an interrupted delivery?' : 'Discard this draft?'"></h1><p class="login-sub" :text="confirmation === 'purge' ? 'These messages cannot be recovered after deletion.' : confirmation === 'reload-draft' ? 'Your local changes will be replaced with the latest saved version. Save a copy to keep both.' : confirmation === 'retry-unknown' ? 'This message may already have arrived. Check Sent and the delivery result before retrying. A retry could send a duplicate.' : 'Your saved draft will move to Trash. Unsaved changes will be discarded.'"></p><button @click="confirmation.set('')" :disabled="confirming" autofocus>Keep working</button><button @click="confirmAction()" :disabled="confirming" :text="confirming ? 'Working…' : confirmation === 'purge' ? 'Delete permanently' : confirmation === 'reload-draft' ? 'Reload saved version' : confirmation === 'retry-unknown' ? 'I checked Sent; review the message' : 'Discard draft'"></button></div></dialog>
</body>
</html>
