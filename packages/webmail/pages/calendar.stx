<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calendar — Mail</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<script client>
import { calendarTimeZoneLabel } from '../functions/calendar-dates'
import { cancelMailReads, restoreMailReads } from '../functions/mail-api'
import { useMailCalendar } from '../functions/use-mail-calendar'
import { reminderDayLink } from '../functions/use-calendar-reminders'
const {
  account, calendars, activeCalendar, activeCalendarName, calendarExport, calendarColor, eventColor, nameFor,
  sharedCalendars, selectedShare, availabilityOnly, canCreateEvent, writableCalendars, busyPeriods, busyPeriodLabel, shareNotice, recheckShares,
  view, calendarViews, calendarDays, monthWeekdays, yearMonths, yearTabDay, moveYearFocus, recurringSeries, rangeLabel, loading, error,
  searchInput, searchTerm, events, search, clearSearch, focusDay, displayZone, calendarTimeZones,
  showDayLabels, showDayLabelEditor, hasDayLabels, labelOnDate, currentDayLabel, canEditDayLabel, editingDayLabel,
  dayLabelDraft, dayLabelSaving, dayLabelConflict, dayLabelError, dayLabelNotice, dayLabelsUnavailable,
  startDayLabel, cancelDayLabel, saveDayLabel,
  taskPanelOpen, tasksReady, taskBusy, taskError, taskConflict, taskNotice, showCompletedTasks, taskEditor, taskTitle, taskDay,
  confirmTaskRemoval, visibleTasks, closeTasks, loadTasks, startTaskEdit, cancelTaskEdit, showTasks, saveTask, setTaskCompleted, taskDateLabel,
  tools, toolsOpen, toolsBusy, toolsError, toolsNotice, toolsConflict, toolsCompact, toolsSections, toolSection,
  toolDate, toolTitle, toolTarget, toolMinutes, editingItem, journalText, journalDates, toolTimeRows, toolTimeTotal, countdownRows,
  selectedImport, removal, loadToolsDisplay, loadTools, closeTools, tickTools, selectToolsSection, selectToolDate, changeToolDate,
  resetItemForm, editToolItem, saveToolItem, toggleHabit, writeJournal, saveJournal, confirmToolRemoval,
  prepareToolsImport, discardToolsImport, importTools, exportTools,
  setToolsEnabled, setToolsAppearance, countdownStatus, toolDateLabel,
  freeTimeOpen, freeTimeDate, freeTimeStart, freeTimeEnd, freeTimeMinutes, freeTimeIncludeOwned, freeTimeBusy,
  freeTimeDurations, freeTimeCanIncludeOwned, freeTimeScope, freeTimeResults, freeTimeError, toggleFreeTime, findFreeTime,
  refresh, selectCalendar, showView, shiftView, goToToday, showDay, changeDate, changeZone, calendarEventDate,
  calendarSettings, calendarSettingsError, calendarSettingsBusy, calendarNameInput, createCalendar, setCalendarColor, toggleCalendarSettings,
  teams, outgoingShares, shareCalendarInput, shareTeamInput, shareGranteeInput, shareAccessInput,
  calendarAccessLabels, grantCalendar, revokeCalendarGrant, selectGrantAccess, teamName,
  openEvent, openNewEvent, editorOpen, editorBusy, editorLoaded, editorError, editorConflict, editingId, editorLabel,
  openMailEvent, sourceEmailLink, waitingMailEvent, editorSourceMessage,
  editorRecurring, editorOccurrence, editorHasOccurrence, editorReadOnly, editorViewer, editorProtectedOccurrence, editorCalendar, editorTitle, editorLocation, editorDescription,
  editorAllDay, editorStart, editorEnd, editorZone, editorScheduleEditable, editorTimeZones,
  editorReminder, editorReminderEditable, otherReminders, reminderOptions,
  repeatFrequency, repeatEvery, repeatEnd, repeatCount, repeatUntil, repeatOptions, changeRepeatEnd,
  confirmDelete, toggleAllDay, setEventBoundary,
  closeEditor, reloadEvent, saveEvent, deleteEvent, showEventScope,
  importOpen, importDestination, newCalendarName, importBusy, importError, importRows, importFinished,
  readyCount, canPreview, resultSummary, toggleImport, selectImportFile, selectImportDestination,
  setNewCalendarName, submitImport, importEventDate, importStatusLabels, destroy,
  visibleReminders, reminderError, dismissingReminder, tickReminders, pollReminders, dismissReminder, destroyReminders,
} = useMailCalendar(() => navigate('/login', { reload: true }), { ref: useRef('eventDialog'), nextTick })
const dayHeading = useRef('dayHeading')
const labelField = useRef('labelField')
const labelTrigger = useRef('labelTrigger')
const freeTimeDateField = useRef('freeTimeDateField')
const jumpDateField = useRef('jumpDateField')
const taskHeading = useRef('taskHeading')
const taskTitleField = useRef('taskTitleField')
const taskDeleteButton = useRef('taskDeleteButton')
const taskSaveButton = useRef('taskSaveButton')
const toolsHeading = useRef('toolsHeading')
const toolTitleField = useRef('toolTitleField')
const toolRemovalButton = useRef('toolRemovalButton')
function changeToolsPanel() {
  if (toolsOpen()) closeTools()
  else {
    closeTasks()
    void loadTools()
    nextTick(() => toolsHeading.current?.focus())
  }
}
function changeTasksPanel() {
  if (taskPanelOpen()) closeTasks()
  else {
    closeTools()
    void loadTasks()
    nextTick(() => taskHeading.current?.focus())
  }
}
function editPersonalTool(item) {
  editToolItem(item)
  nextTick(() => toolTitleField.current?.focus())
}
function askToRemoveTool(section, key, title) {
  removal.set({ section, key, title })
  nextTick(() => toolRemovalButton.current?.focus())
}
async function removePersonalTool() {
  if (await confirmToolRemoval()) nextTick(() => toolsHeading.current?.focus())
}
async function reloadTasks() {
  await loadTasks()
  nextTick(() => taskHeading.current?.focus())
}
function editTask(task = null) {
  startTaskEdit(task)
  nextTick(() => taskTitleField.current?.focus())
}
function closeTaskEdit() {
  cancelTaskEdit()
  nextTick(() => taskHeading.current?.focus())
}
function askToDeleteTask() {
  confirmTaskRemoval.set(true)
  nextTick(() => taskDeleteButton.current?.focus())
}
function clearTaskDate() {
  taskDay.set('')
  nextTick(() => taskSaveButton.current?.focus())
}
async function submitTask(remove = false) {
  if (await saveTask(remove)) nextTick(() => taskHeading.current?.focus())
}
async function toggleTaskCompletion(task) {
  if (await setTaskCompleted(task)) nextTick(() => taskHeading.current?.focus())
}
function changeFreeTimePanel() {
  toggleFreeTime()
  if (freeTimeOpen()) nextTick(() => freeTimeDateField.current?.focus())
}
function openJumpDatePicker() {
  const input = jumpDateField.current as HTMLInputElement | null
  if (!input) return
  input.focus({ preventScroll: true })
  input.showPicker?.()
}
function editLabel() {
  startDayLabel()
  nextTick(() => labelField.current?.focus())
}
function closeLabel() {
  if (dayLabelSaving()) return
  cancelDayLabel()
  nextTick(() => labelTrigger.current?.focus())
}
async function submitLabel(clear = false) {
  if (await saveDayLabel(clear)) nextTick(() => labelTrigger.current?.focus())
}
async function reloadLabel() {
  cancelDayLabel()
  await refresh()
  nextTick(() => labelTrigger.current?.focus())
}
function openYearDay(day) {
  void showDay(day)
  nextTick(() => dayHeading.current?.focus())
}
async function bootCalendar() { await refresh(); await openMailEvent(); void pollReminders() }
useInterval(tickReminders, 1000, { whileVisible: true })
useInterval(tickTools, 30000, { whileVisible: true })
useInterval(pollReminders, 30000, { whileVisible: true })
useInterval(recheckShares, 30000, { whileVisible: true })
useEventListener('focus', pollReminders)
useEventListener('focus', tickTools)
useEventListener('focus', recheckShares)
useEventListener('online', pollReminders)
useEventListener('online', recheckShares)
useEventListener('beforeunload', cancelMailReads)
onMount(bootCalendar)
useEventListener('pagehide', cancelMailReads)
useEventListener('pageshow', restoreMailReads)
onUnmounted(() => { destroy(); destroyReminders() })
</script>
<main class="calendar-page">
  <nav class="calendar-nav" aria-label="Mail navigation"><a href="/"><span class="mail-icon" data-icon="back" aria-hidden="true"></span>Back to inbox</a><span :if="account" :text="account"></span></nav>
  <header class="calendar-header">
    <div class="calendar-heading"><span class="mail-app-mark"><span class="mail-icon" data-icon="calendar" aria-hidden="true"></span></span><h1>Calendar</h1></div>
    <div :if="account" class="calendar-choices">
      <button :if="!selectedShare" type="button" class="wm-action" :aria-expanded="taskPanelOpen" aria-controls="calendar-tasks" :disabled="taskBusy || toolsBusy" @click="changeTasksPanel()"><span class="mail-icon" data-icon="checklist" aria-hidden="true"></span>Tasks</button>
      <button :if="!selectedShare" type="button" class="wm-action" :aria-expanded="toolsOpen" aria-controls="calendar-tools" :disabled="toolsBusy || taskBusy" @click="changeToolsPanel()"><span class="mail-icon" data-icon="bookmark" aria-hidden="true"></span>Personal tools</button>
      <button class="wm-action" @click="toggleCalendarSettings()" :disabled="loading && !calendarSettings" :aria-expanded="calendarSettings" aria-controls="calendar-settings"><span class="mail-icon" data-icon="settings" aria-hidden="true"></span>Manage calendars</button>
      <button class="wm-action" @click="toggleImport()" :disabled="importBusy" :aria-expanded="importOpen" aria-controls="calendar-import"><span class="mail-icon" data-icon="upload" aria-hidden="true"></span>Import .ics</button>
      <a :if="calendarExport" class="wm-action" :href="calendarExport"><span class="mail-icon" data-icon="download" aria-hidden="true"></span>Download .ics</a>
      <button :if="canCreateEvent" class="wm-action calendar-primary" @click="openNewEvent()"><span class="mail-icon" data-icon="plus" aria-hidden="true"></span>New event</button>
    </div>
  </header>
  <section :if="taskPanelOpen && !selectedShare" id="calendar-tasks" class="calendar-tasks" aria-labelledby="calendar-tasks-heading">
    <div class="calendar-tasks-heading">
      <h2 id="calendar-tasks-heading" tabindex="-1" ref="taskHeading">Personal tasks</h2>
      <div :if="tasksReady" class="calendar-choices calendar-view-modes calendar-task-status" role="group" aria-label="Task status">
        <button type="button" class="wm-action" :aria-pressed="!showCompletedTasks" :disabled="taskBusy || taskEditor" @click="showTasks(false)">Open</button>
        <button type="button" class="wm-action" :aria-pressed="showCompletedTasks" :disabled="taskBusy || taskEditor" @click="showTasks(true)">Completed</button>
      </div>
      <button :if="tasksReady && !taskEditor" type="button" class="wm-action calendar-primary" :disabled="taskBusy || taskConflict" @click="editTask()"><span class="mail-icon" data-icon="plus" aria-hidden="true"></span>Add task</button>
    </div>
    <p :if="taskBusy && !tasksReady" class="calendar-task-empty" role="status">Loading tasks…</p>
    <p :if="taskError" class="calendar-label-error" role="alert" :text="taskError"></p>
    <button :if="taskConflict || (taskError && !tasksReady)" type="button" class="wm-action" :disabled="taskBusy" @click="reloadTasks()">Load latest tasks</button>
    <form :if="taskEditor" class="calendar-task-form" aria-label="Task details" @submit.prevent="submitTask()">
      <label>Task title<input ref="taskTitleField" type="text" x-model="taskTitle" :disabled="taskBusy" autocomplete="off" maxlength="240" required></label>
      <div class="calendar-task-date">
        <label for="calendar-task-day">Date (optional)</label>
        <div class="calendar-task-actions">
          <div class="calendar-task-date-field" :data-empty="taskDay ? 'false' : 'true'">
            <input id="calendar-task-day" type="date" :value="taskDay" @input="taskDay.set($event.target.value)" @change="taskDay.set($event.target.value)" :disabled="taskBusy" min="0001-01-01" max="9999-12-31">
            <span :if="!taskDay" class="calendar-task-date-placeholder" aria-hidden="true">No date</span>
          </div>
          <button :if="taskDay" type="button" class="wm-action calendar-task-clear" :disabled="taskBusy" aria-label="Clear date" title="Clear date" @click="clearTaskDate()"><span class="mail-icon" data-icon="close" aria-hidden="true"></span></button>
        </div>
      </div>
      <div class="calendar-task-actions">
        <button ref="taskSaveButton" type="submit" class="wm-action calendar-primary" :disabled="taskBusy || taskConflict" :text="taskEditor.task ? 'Save task' : 'Add task'"></button>
        <button type="button" class="wm-action" :disabled="taskBusy" @click="closeTaskEdit()">Cancel</button>
        <button :if="taskEditor.task && !confirmTaskRemoval" type="button" class="wm-action wm-action--danger" :disabled="taskBusy || taskConflict" @click="askToDeleteTask()">Delete task</button>
        <button :if="confirmTaskRemoval" type="button" class="wm-action wm-action--danger" ref="taskDeleteButton" :disabled="taskBusy || taskConflict" @click="submitTask(true)">Confirm deletion</button>
      </div>
    </form>
    <ul :if="visibleTasks.length" class="calendar-task-list" aria-label="Tasks" :aria-busy="taskBusy">
      <li :for="task in visibleTasks" :key="task.id">
        <div class="calendar-task-summary">
          <strong :text="task.title"></strong>
          <a :if="task.day && calendars.length" :href="'/calendar?day=' + task.day" :text="taskDateLabel(task.day)"></a>
          <span :if="!task.day || !calendars.length" :text="taskDateLabel(task.day)"></span>
        </div>
        <div class="calendar-task-actions">
          <button type="button" class="wm-action" :disabled="taskBusy || taskConflict || taskEditor" :aria-label="(task.completed ? 'Reopen ' : 'Complete ') + task.title" @click="toggleTaskCompletion(task)"><span :if="!task.completed" class="mail-icon" data-icon="check" aria-hidden="true"></span><span :text="task.completed ? 'Reopen' : 'Complete'"></span></button>
          <button type="button" class="wm-action" :disabled="taskBusy || taskConflict || taskEditor" :aria-label="'Edit ' + task.title" @click="editTask(task)">Edit</button>
        </div>
      </li>
    </ul>
    <p :if="tasksReady && !visibleTasks.length && !taskEditor" class="calendar-task-empty" :text="showCompletedTasks ? 'No completed tasks.' : 'No open tasks.'"></p>
    <p class="wm-a11y-text" role="status" :text="taskNotice"></p>
  </section>
  <section :if="toolsOpen && !selectedShare" id="calendar-tools" class="calendar-tools" aria-labelledby="calendar-tools-heading">
    <div class="calendar-tools-heading">
      <h2 id="calendar-tools-heading" tabindex="-1" ref="toolsHeading">Personal tools</h2>
      <button :if="tools && !tools.enabled" type="button" class="wm-action calendar-primary" :disabled="toolsBusy || toolsConflict" @click="setToolsEnabled(true)">Enable personal tools</button>
    </div>
    <p :if="toolsBusy && !tools" role="status">Loading personal tools…</p>
    <p :if="toolsError" class="calendar-label-error" role="alert" :text="toolsError"></p>
    <button :if="toolsConflict || (!tools && toolsError)" type="button" class="wm-action" :disabled="toolsBusy" @click="loadTools()">Load latest personal tools</button>
    <p :if="tools && !tools.enabled" class="calendar-tools-muted">Keep countdowns, check off habits, write journal notes, and log time. Your tools stay private to this mailbox.</p>
    <div :if="tools && tools.enabled" class="calendar-tools-tabs" role="group" aria-label="Choose a personal tool">
      <button :for="section in toolsSections" :key="section.id" type="button" class="wm-action" :aria-pressed="toolSection === section.id" :disabled="toolsBusy" @click="selectToolsSection(section.id)" :text="section.label"></button>
    </div>
    <div :if="tools && tools.enabled && (toolSection === 'habits' || toolSection === 'journal' || toolSection === 'time')" class="calendar-tools-date calendar-tools-form">
      <label>Entry date<input type="date" :value="toolDate" min="0001-01-01" max="9999-12-31" :disabled="toolsBusy" required @change="changeToolDate($event)"></label>
    </div>
    <form :if="tools && tools.enabled && (toolSection === 'countdowns' || toolSection === 'habits' || toolSection === 'time')" class="calendar-tools-form" aria-label="Personal tool entry" @submit.prevent="saveToolItem(toolSection)">
      <label class="calendar-tools-title"><span :text="toolSection === 'habits' ? 'Habit name' : toolSection === 'time' ? 'Activity' : 'Countdown name'"></span>
        <input ref="toolTitleField" type="text" x-model="toolTitle" :disabled="toolsBusy" maxlength="200" autocomplete="off" required>
      </label>
      <label :if="toolSection === 'countdowns'">Target date<input type="date" x-model="toolTarget" :disabled="toolsBusy" min="0001-01-01" max="9999-12-31" required></label>
      <label :if="toolSection === 'time'">Minutes<input class="calendar-tools-minutes" type="number" x-model="toolMinutes" :disabled="toolsBusy" min="1" max="1440" step="1" required></label>
      <button type="submit" class="wm-action calendar-primary" :disabled="toolsBusy || toolsConflict" :text="editingItem ? 'Save entry' : toolSection === 'time' ? 'Log time' : toolSection === 'habits' ? 'Add habit' : 'Add countdown'"></button>
      <button :if="editingItem" type="button" class="wm-action" :disabled="toolsBusy" @click="resetItemForm()">Cancel edit</button>
    </form>
    <ul :if="tools && tools.enabled && toolSection === 'countdowns' && countdownRows.length" class="calendar-tools-list" aria-label="Countdowns">
      <li :for="item in countdownRows" :key="item.id">
        <div class="calendar-tools-item"><strong :text="item.title"></strong><span :text="toolDateLabel(item.day) + ' · ' + countdownStatus(item.day)"></span></div>
        <button type="button" class="wm-action" :aria-label="'Edit ' + item.title" :disabled="toolsBusy" @click="editPersonalTool(item)">Edit</button>
        <button type="button" class="wm-action wm-action--danger" :aria-label="'Remove ' + item.title" :disabled="toolsBusy || toolsConflict" @click="askToRemoveTool('countdowns', item.id, item.title)">Remove</button>
      </li>
    </ul>
    <ul :if="tools && tools.enabled && toolSection === 'habits' && tools.habits.length" class="calendar-tools-list" aria-label="Habits">
      <li :for="item in tools.habits" :key="item.id">
        <div class="calendar-tools-item"><strong :text="item.title"></strong><span :text="item.days.length + (item.days.length === 1 ? ' check-in' : ' check-ins')"></span></div>
        <button type="button" class="wm-action" :aria-label="'Check in for ' + item.title" :aria-pressed="item.days.includes(toolDate)" :disabled="toolsBusy || toolsConflict" @click="toggleHabit(item)">
          <span :if="item.days.includes(toolDate)" class="mail-icon" data-icon="check" aria-hidden="true"></span><span :text="item.days.includes(toolDate) ? 'Checked in' : 'Check in'"></span>
        </button>
        <button type="button" class="wm-action" :aria-label="'Edit ' + item.title" :disabled="toolsBusy" @click="editPersonalTool(item)">Edit</button>
        <button type="button" class="wm-action wm-action--danger" :aria-label="'Remove ' + item.title" :disabled="toolsBusy || toolsConflict" @click="askToRemoveTool('habits', item.id, item.title)">Remove</button>
      </li>
    </ul>
    <form :if="tools && tools.enabled && toolSection === 'journal'" class="calendar-tools-form calendar-tools-journal" @submit.prevent="saveJournal()">
      <label>Journal note<textarea :value="journalText" @input="writeJournal($event.target.value)" :disabled="toolsBusy" maxlength="4000" rows="4" required></textarea></label>
      <button type="submit" class="wm-action calendar-primary" :disabled="toolsBusy || toolsConflict">Save note</button>
      <button :if="tools.journal.some(entry => entry.day === toolDate)" type="button" class="wm-action wm-action--danger" :disabled="toolsBusy || toolsConflict" @click="askToRemoveTool('journal', toolDate, 'Journal note for ' + toolDateLabel(toolDate))">Remove note</button>
      <label :if="journalDates.length" class="calendar-tools-saved-notes">Saved notes<select :value="toolDate" :disabled="toolsBusy" @change="selectToolDate($event.target.value)">
        <option :if="!journalDates.includes(toolDate)" value="">Choose a date</option>
        <option :for="date in journalDates" :key="date" :value="date" :text="toolDateLabel(date)"></option>
      </select></label>
    </form>
    <div :if="tools && tools.enabled && toolSection === 'time' && toolTimeRows.length" class="calendar-tools-time">
      <p class="calendar-tools-muted" :text="toolTimeTotal + ' min logged'" role="status"></p>
      <ul class="calendar-tools-list" aria-label="Time entries">
        <li :for="item in toolTimeRows" :key="item.id">
          <div class="calendar-tools-item"><strong :text="item.title"></strong><span :text="item.minutes + ' min'"></span></div>
          <button type="button" class="wm-action" :aria-label="'Edit ' + item.title" :disabled="toolsBusy" @click="editPersonalTool(item)">Edit</button>
          <button type="button" class="wm-action wm-action--danger" :aria-label="'Remove ' + item.title" :disabled="toolsBusy || toolsConflict" @click="askToRemoveTool('time', item.id, item.title)">Remove</button>
        </li>
      </ul>
    </div>
    <div :if="removal" class="calendar-tools-confirm" role="group" aria-label="Confirm removal">
      <p :text="'Remove ' + removal.title + '?'"></p>
      <button ref="toolRemovalButton" type="button" class="wm-action wm-action--danger" :disabled="toolsBusy || toolsConflict" @click="removePersonalTool()">Confirm removal</button>
      <button type="button" class="wm-action" :disabled="toolsBusy" @click="removal.set(null)">Cancel removal</button>
    </div>
    <div :if="tools && (!tools.enabled || toolSection === 'display')" class="calendar-tools-settings">
      <div :if="tools.enabled" class="calendar-tools-settings-row" role="group" aria-label="Calendar density">
        <strong>Calendar density</strong>
        <button type="button" class="wm-action" :aria-pressed="tools.appearance === 'standard'" :disabled="toolsBusy || toolsConflict" @click="setToolsAppearance('standard')">Standard</button>
        <button type="button" class="wm-action" :aria-pressed="tools.appearance === 'compact'" :disabled="toolsBusy || toolsConflict" @click="setToolsAppearance('compact')">Compact</button>
      </div>
      <div class="calendar-tools-form calendar-tools-data">
        <label>Import personal tools<input type="file" accept=".json,application/json" :disabled="toolsBusy || toolsConflict" @change="prepareToolsImport($event)"></label>
        <button type="button" class="wm-action" :disabled="toolsBusy" @click="exportTools()"><span class="mail-icon" data-icon="download" aria-hidden="true"></span>Export JSON</button>
        <button :if="tools.enabled" type="button" class="wm-action" :disabled="toolsBusy || toolsConflict" @click="setToolsEnabled(false)">Turn off personal tools</button>
      </div>
      <div :if="selectedImport" class="calendar-tools-confirm" role="group" aria-label="Confirm personal tools import">
        <p :text="'Replace your personal tools with ' + selectedImport.filename + '?'"></p>
        <button type="button" class="wm-action calendar-primary" :disabled="toolsBusy || toolsConflict" @click="importTools()">Replace personal tools</button>
        <button type="button" class="wm-action" :disabled="toolsBusy" @click="discardToolsImport()">Cancel import</button>
      </div>
    </div>
    <p class="wm-a11y-text" role="status" :text="toolsNotice"></p>
  </section>
  <div :if="error" class="login-error" role="alert"><span :text="error"></span> <button class="wm-action" @click="refresh()">Retry</button></div>
  <p :if="shareNotice" class="calendar-share-notice" role="status" :text="shareNotice"></p>
  <p :if="loading && (!account || (!calendars.length && !sharedCalendars.length))" class="calendar-loading" role="status">Loading calendar…</p>
  <p :if="!loading && !error && !calendars.length && !sharedCalendars.length && !importOpen && !calendarSettings">Create a calendar or import an .ics file to get started.</p>
  <section :if="calendarSettings" id="calendar-settings" class="calendar-import" aria-label="Manage calendars" :aria-busy="calendarSettingsBusy">
    <p :if="waitingMailEvent" role="status">Create a calendar to save an event from this email.</p>
    <form class="calendar-import-form calendar-create-form" @submit.prevent="createCalendar()">
      <label>Calendar name<input x-model="calendarNameInput" :disabled="calendarSettingsBusy" maxlength="100" required></label>
      <button type="submit" class="wm-action" :disabled="calendarSettingsBusy">Create calendar</button>
    </form>
    <div :if="calendarSettingsError" class="login-error" role="alert" :text="calendarSettingsError"></div>
    <div :if="calendars.length" class="calendar-colors">
      <label :for="item in calendars"><input type="color" :value="calendarColor(item.color)" :aria-label="'Color for ' + item.name" :disabled="calendarSettingsBusy" @change="setCalendarColor(item, $event)"><span :text="item.name"></span></label>
    </div>
    <section :if="calendars.length && teams.length" class="calendar-sharing" aria-labelledby="share-calendar-heading">
      <h2 id="share-calendar-heading">Share a calendar</h2>
      <form class="calendar-import-form calendar-share-form" @submit.prevent="grantCalendar()">
        <label>Calendar to share<select :value="shareCalendarInput || String(calendars[0]?.id || '')" @change="shareCalendarInput.set($event.target.value)" :disabled="calendarSettingsBusy">
          <option :for="item in calendars" :value="item.id" :text="item.name"></option>
        </select></label>
        <label>Team<select :value="shareTeamInput || teams[0]?.id" @change="shareTeamInput.set($event.target.value)" :disabled="calendarSettingsBusy">
          <option :for="team in teams" :value="team.id" :text="team.name"></option>
        </select></label>
        <label>Teammate<input type="email" x-model="shareGranteeInput" autocomplete="off" placeholder="name@example.com" :disabled="calendarSettingsBusy" required></label>
        <label>Access<select x-model="shareAccessInput" :disabled="calendarSettingsBusy">
          <option value="viewer">View events</option><option value="editor">Edit events</option><option value="free_busy">Free/busy only</option>
        </select></label>
        <button type="submit" class="wm-action calendar-primary" :disabled="calendarSettingsBusy"><span class="mail-icon" data-icon="people" aria-hidden="true"></span>Share calendar</button>
      </form>
      <ul :if="outgoingShares.length" class="calendar-share-list" aria-label="Calendar access you granted">
        <li :for="share in outgoingShares" :key="share.team + ':' + share.calendarId + ':' + share.grantee">
          <div class="calendar-share-details"><strong :text="share.calendarName"></strong><small :text="share.grantee + ' · ' + teamName(share.team)"></small></div>
          <div class="calendar-share-actions">
            <label>Access<select :value="share.access" :disabled="calendarSettingsBusy" :aria-label="'Access for ' + share.grantee + ' to ' + share.calendarName" @change="selectGrantAccess(share, $event)">
              <option value="viewer">View events</option><option value="editor">Edit events</option><option value="free_busy">Free/busy only</option>
            </select></label>
            <button type="button" class="wm-action wm-action--danger" :disabled="calendarSettingsBusy" :aria-label="'Revoke access for ' + share.grantee + ' to ' + share.calendarName" @click="revokeCalendarGrant(share)">Revoke</button>
          </div>
        </li>
      </ul>
    </section>
  </section>
  <section :if="importOpen" id="calendar-import" class="calendar-import" aria-label="Import calendar" :aria-busy="importBusy">
    <form class="calendar-import-form calendar-ics-form" @submit.prevent="submitImport('preview')">
      <label>Calendar file<input type="file" accept=".ics,text/calendar" @change="selectImportFile($event)" :disabled="importBusy"></label>
      <label>Destination calendar<select :value="importDestination" @change="selectImportDestination($event)" :disabled="importBusy">
        <option value="new">Create a calendar</option>
        <option :for="item in calendars" :value="item.id" :text="item.name"></option>
      </select></label>
      <label :if="importDestination === 'new'" class="calendar-ics-name">New calendar name<input :value="newCalendarName" @input="setNewCalendarName($event)" :disabled="importBusy" maxlength="100" required></label>
      <button type="submit" class="wm-action" :disabled="!canPreview">Preview</button>
    </form>
    <div :if="importError" class="login-error" role="alert" :text="importError"></div>
    <p :if="importBusy" role="status">Reading calendar file…</p>
    <p :if="importRows.length" role="status" :text="resultSummary"></p>
    <ul :if="importRows.length" class="calendar-events calendar-import-results" aria-label="Event results">
      <li :for="event in importRows">
        <strong :text="event.summary"></strong>
        <span :if="event.start !== null" :text="importEventDate(event)"></span>
        <span :text="importStatusLabels[event.status]"></span>
        <span :if="event.message" :text="event.message"></span>
      </li>
    </ul>
    <button :if="readyCount && !importFinished" class="wm-action" @click="submitImport('import')" :disabled="importBusy">Import events</button>
  </section>
  <section :if="account && (calendars.length || sharedCalendars.length)" class="calendar-workspace" :class="{ 'calendar-workspace-compact': toolsCompact && !selectedShare }" aria-label="Calendar workspace" :aria-busy="loading">
    <div class="calendar-controls">
      <div class="calendar-choices calendar-sources" role="group" aria-label="Calendars">
        <button :if="calendars.length" class="wm-action" @click="selectCalendar(null)" :aria-pressed="activeCalendar === null" :text="sharedCalendars.length ? 'My calendars' : 'All calendars'"></button>
        <button :for="item in calendars" class="wm-action" @click="selectCalendar(item.id)" :aria-pressed="item.id === activeCalendar">
          <span class="calendar-dot" :style="'background:' + calendarColor(item.color)" aria-hidden="true"></span><span :text="item.name"></span>
        </button>
        <button :for="share in sharedCalendars" :key="share.calendarId" class="wm-action calendar-shared-choice" @click="selectCalendar(share.calendarId)" :aria-pressed="share.calendarId === activeCalendar">
          <span class="mail-icon" data-icon="people" aria-hidden="true"></span>
          <span><strong :text="share.calendarName"></strong><small :text="share.source + ' · ' + calendarAccessLabels[share.access]"></small></span>
        </button>
      </div>
      <div :if="calendars.length || selectedShare" class="calendar-source-tools">
        <form :if="!availabilityOnly" class="calendar-choices calendar-search" role="search" @submit.prevent="search()">
          <div class="mail-search-field"><span class="mail-icon" data-icon="search" aria-hidden="true"></span><input class="wm-search" type="search" x-model="searchInput" aria-label="Search events" placeholder="Search events" maxlength="256"><button type="submit" class="wm-search-submit" aria-label="Search" title="Search"><span class="mail-icon" data-icon="arrow-right" aria-hidden="true"></span></button></div>
          <button :if="searchTerm" type="button" class="wm-action" @click="clearSearch()">Clear</button>
        </form>
        <button type="button" class="wm-action" :aria-expanded="freeTimeOpen" aria-controls="calendar-free-time" @click="changeFreeTimePanel()"><span class="mail-icon" data-icon="clock" aria-hidden="true"></span>Find free time</button>
      </div>
    </div>
    <p :if="!calendars.length && !selectedShare">Choose a shared calendar.</p>
    <div :if="calendars.length || selectedShare" class="calendar-controls calendar-view-toolbar">
      <div class="calendar-choices calendar-view-modes" role="group" aria-label="Calendar view">
        <button :for="mode in calendarViews" class="wm-action" @click="showView(mode.id)" :aria-pressed="!searchTerm && view === mode.id" :text="mode.name"></button>
      </div>
      <label class="calendar-view-picker">View
        <select aria-label="Calendar view" :value="searchTerm ? '' : view" @change="showView($event.target.value)">
          <option :if="searchTerm" value="" disabled>Search results</option>
          <option :for="mode in calendarViews" :value="mode.id" :text="mode.name"></option>
        </select>
      </label>
      <div :if="!searchTerm" class="calendar-choices calendar-period" role="group" aria-label="Change date range">
        <div class="calendar-period-buttons">
          <button class="wm-action calendar-arrow" @click="shiftView(-1)" aria-label="Previous period"><span class="mail-icon" data-icon="left" aria-hidden="true"></span></button>
          <button class="wm-action calendar-today" @click="goToToday()">Today</button>
          <button class="wm-action calendar-arrow" @click="shiftView(1)" aria-label="Next period"><span class="mail-icon" data-icon="right" aria-hidden="true"></span></button>
        </div>
        <div class="calendar-jump">
          <input ref="jumpDateField" type="date" aria-label="Jump to date" min="0001-01-01" max="9999-12-31" :value="focusDay" @change="changeDate($event)">
          <button type="button" class="calendar-jump-picker" aria-label="Open date picker" @click="openJumpDatePicker()"><span class="mail-icon" data-icon="calendar" aria-hidden="true"></span></button>
        </div>
      </div>
      <label class="calendar-zone">Time zone
        <select aria-label="Display time zone" :value="displayZone" @change="changeZone($event)">
          <option :for="zone in calendarTimeZones" :value="zone" :text="calendarTimeZoneLabel(zone)"></option>
        </select>
      </label>
    </div>

    <p :if="loading" class="calendar-loading" role="status">Loading calendar…</p>
    <section :if="freeTimeOpen && (calendars.length || selectedShare)" id="calendar-free-time" class="calendar-free-time" aria-labelledby="calendar-free-time-heading" :aria-busy="freeTimeBusy">
      <div class="calendar-free-time-heading">
        <h2 id="calendar-free-time-heading">Find free time</h2>
        <p :text="freeTimeScope + ' · ' + displayZone"></p>
      </div>
      <form class="calendar-free-time-form" @submit.prevent="findFreeTime()">
        <label>Date<input ref="freeTimeDateField" type="date" x-model="freeTimeDate" required :disabled="freeTimeBusy"></label>
        <label>From<input type="time" x-model="freeTimeStart" required :disabled="freeTimeBusy"></label>
        <label>To<input type="time" x-model="freeTimeEnd" required :disabled="freeTimeBusy"></label>
        <label>Minimum duration<select x-model="freeTimeMinutes" :disabled="freeTimeBusy">
          <option :for="minutes in freeTimeDurations" :value="String(minutes)" :text="minutes + ' min'"></option>
        </select></label>
        <button type="submit" class="wm-action calendar-primary" :disabled="freeTimeBusy">
          <span :aria-hidden="freeTimeBusy">Check availability</span>
          <span :aria-hidden="!freeTimeBusy">Checking…</span>
        </button>
        <label :if="freeTimeCanIncludeOwned" class="calendar-free-time-personal"><input type="checkbox" :checked="freeTimeIncludeOwned" @change="freeTimeIncludeOwned.set($event.target.checked)" :disabled="freeTimeBusy">Include my calendars</label>
      </form>
      <p :if="freeTimeError" class="calendar-label-error" role="alert" :text="freeTimeError"></p>
      <div :if="freeTimeResults" class="calendar-free-time-output">
        <p role="status" :text="freeTimeResults.length ? freeTimeResults.length + (freeTimeResults.length === 1 ? ' open window' : ' open windows') : 'No open windows match this duration.'"></p>
        <ul :if="freeTimeResults.length" class="calendar-free-time-results" aria-label="Open windows">
          <li :for="slot in freeTimeResults" :key="slot.start"><span :text="slot.time"></span><small :text="slot.minutes + ' min'"></small></li>
        </ul>
      </div>
    </section>

    <section :if="searchTerm" aria-labelledby="calendar-search-results">
      <h2 id="calendar-search-results" class="calendar-range" :text="'Search results · ' + activeCalendarName"></h2>
      <p :if="!loading && !error && !events.length">No events match this search.</p>
      <ul class="calendar-result-list">
        <li :for="event in events">
          <button class="calendar-result" @click="openEvent(event)" :style="'--calendar-color:' + eventColor(event)">
            <strong :text="event.summary || 'Untitled event'"></strong>
            <span :text="(event.recurring ? 'Series start · ' : '') + calendarEventDate(event)"></span>
            <span :text="nameFor(event)"></span>
            <span :if="event.location" :text="event.location"></span>
          </button>
        </li>
      </ul>
    </section>

    <div :if="!searchTerm && (calendars.length || selectedShare)" :class="{ 'calendar-year-heading': view === 'year' }">
      <h2 id="calendar-range" ref="dayHeading" tabindex="-1" class="calendar-range" :text="availabilityOnly && view !== 'year' ? 'Free/busy' : rangeLabel" aria-live="polite"></h2>
      <span :if="view === 'year'" class="calendar-year-legend"><span class="calendar-year-marker" aria-hidden="true"></span><span :text="availabilityOnly ? 'Busy day' : 'Events scheduled'"></span></span>
      <span :if="view === 'year' && hasDayLabels" class="calendar-year-legend"><span class="calendar-day-label-mark" aria-hidden="true"></span>Day label</span>
    </div>
    <div :if="showDayLabels && dayLabelsUnavailable" class="calendar-label-error" role="alert">
      <span :text="dayLabelsUnavailable"></span><button type="button" class="wm-action" @click="refresh()">Retry day labels</button>
    </div>

    <section :if="showDayLabelEditor" class="calendar-day-label-editor" aria-label="Day label">
      <div :if="!editingDayLabel" class="calendar-day-label-summary">
        <span :if="currentDayLabel" class="calendar-day-label-text">
          <span class="calendar-day-label-mark" aria-hidden="true"></span><span :text="currentDayLabel"></span>
        </span>
        <button ref="labelTrigger" :if="canEditDayLabel" type="button" class="wm-action" @click="editLabel()"
          :text="currentDayLabel ? 'Edit day label' : 'Add day label'"></button>
      </div>
      <form :if="editingDayLabel" class="calendar-label-form" @submit.prevent="submitLabel()" @keydown.escape="closeLabel()">
        <label>Day label<input ref="labelField" type="text" x-model="dayLabelDraft" :disabled="dayLabelSaving" autocomplete="off" placeholder="e.g. Travel day"></label>
        <div class="calendar-label-actions">
          <button type="submit" class="wm-action calendar-primary" :disabled="dayLabelSaving || dayLabelConflict">Save label</button>
          <button :if="currentDayLabel" type="button" class="wm-action wm-action--danger" :disabled="dayLabelSaving || dayLabelConflict" @click="submitLabel(true)">Remove label</button>
          <button type="button" class="wm-action" :disabled="dayLabelSaving" @click="closeLabel()">Cancel</button>
        </div>
        <p :if="dayLabelError" class="calendar-label-error" role="alert" :text="dayLabelError"></p>
        <button :if="dayLabelConflict" type="button" class="wm-action" @click="reloadLabel()">Load latest label</button>
      </form>
      <p :if="dayLabelNotice" class="wm-a11y-text" role="status" :text="dayLabelNotice"></p>
    </section>

    <section :if="availabilityOnly && view !== 'year'" aria-labelledby="calendar-range">
      <p :text="rangeLabel"></p>
      <p :if="!loading && !error && !busyPeriods.length">No busy times in this period.</p>
      <ul :if="busyPeriods.length" class="calendar-share-list" aria-label="Busy periods">
        <li :for="period in busyPeriods" :key="period.start">
          <span class="mail-icon" data-icon="clock" aria-hidden="true"></span><strong>Busy</strong>
          <span :text="busyPeriodLabel(period)"></span>
        </li>
      </ul>
    </section>

    <section :if="!searchTerm && view === 'year'" aria-label="Year overview">
      <p :if="!availabilityOnly && recurringSeries.length" role="status">Some recurring dates could not be shown. Open a month or day to check those dates.</p>
      <p id="calendar-year-keys" class="wm-a11y-text">Use the arrow keys to choose a date and Enter to open it.</p>
      <div class="calendar-year" role="group" aria-label="Days of the year" aria-describedby="calendar-year-keys" @keydown="moveYearFocus($event)">
        <section :for="month in yearMonths" :key="month.id" class="calendar-year-month" :aria-label="month.name">
          <h3 :text="month.name"></h3>
          <div class="calendar-year-weekdays" aria-hidden="true">
            <span :for="label in monthWeekdays" :text="label"></span>
          </div>
          <div class="calendar-year-days">
            <button :for="day in month.days" :key="day.date" type="button" class="calendar-year-day"
              :data-date="day.date" :tabindex="day.date === yearTabDay ? 0 : -1"
              :aria-label="day.label + (day.busy ? ', busy' : day.count ? ', ' + day.count + (day.count === 1 ? ' event' : ' events') : '') + (labelOnDate(day.date) ? ', ' + labelOnDate(day.date) : '')"
              :title="labelOnDate(day.date) || undefined"
              :aria-current="day.today ? 'date' : undefined" :class="{ 'calendar-year-day--marked': day.busy || day.count }"
              :style="day.number === 1 ? 'grid-column-start:' + month.firstColumn : ''" @click="openYearDay(day.date)">
              <span :text="day.number"></span>
              <span :if="day.busy || day.count || labelOnDate(day.date)" class="calendar-year-marks" aria-hidden="true">
                <span :if="day.busy || day.count" class="calendar-year-marker"></span>
                <span :if="labelOnDate(day.date)" class="calendar-day-label-mark"></span>
              </span>
            </button>
          </div>
        </section>
      </div>
    </section>

    <section :if="!searchTerm && !availabilityOnly && view !== 'year' && (calendars.length || selectedShare)" aria-labelledby="calendar-range">
      <p :if="!loading && !error && view === 'agenda' && !calendarDays.length">No events in this period.</p>
      <div :if="view === 'month'" class="calendar-weekdays" aria-hidden="true">
        <span :for="label in monthWeekdays" :text="label"></span>
      </div>
      <div :class="'calendar-board calendar-board-' + view">
        <section :for="day in calendarDays" :class="'calendar-day' + (day.dimmed ? ' calendar-day-muted' : '') + (day.today ? ' calendar-day-today' : '')" :aria-label="day.label">
          <div class="calendar-day-heading">
            <button class="calendar-day-link" :aria-label="day.label + (view === 'month' && day.entries.length ? ', ' + day.entries.length + (day.entries.length === 1 ? ' event' : ' events') : '') + (view !== 'day' && labelOnDate(day.day) ? ', ' + labelOnDate(day.day) : '')" :aria-current="day.today ? 'date' : undefined" @click="showDay(day.day)">
              <span :if="view === 'month'" :text="day.number"></span><span :if="view !== 'month'" :text="day.label"></span>
              <span :if="view === 'month' && day.entries.length" class="calendar-month-markers" aria-hidden="true">
                <span :for="marker in day.markers" class="calendar-dot" :style="'background:' + eventColor(marker)"></span>
                <span :if="day.entries.length > 3" :text="'+' + (day.entries.length - 3)"></span>
              </span>
            </button>
            <button :if="view !== 'month' && canCreateEvent" class="calendar-day-add" :aria-label="'New event on ' + day.label" @click="openNewEvent(day.day)"><span class="mail-icon" data-icon="plus" aria-hidden="true"></span></button>
          </div>
          <div :if="view !== 'day' && labelOnDate(day.day)" class="calendar-day-label-text" :title="labelOnDate(day.day)">
            <span class="calendar-day-label-mark" aria-hidden="true"></span><span :text="labelOnDate(day.day)"></span>
          </div>
          <ul class="calendar-day-entries">
            <li :for="entry in day.entries">
              <button @click="openEvent(entry)" :class="'calendar-entry' + (entry.all_day ? ' calendar-entry-all-day' : '')" :style="'--calendar-color:' + eventColor(entry)" :title="entry.summary + ' · ' + nameFor(entry)">
                <span class="calendar-entry-time"><span class="mail-icon" :data-icon="entry.all_day ? 'calendar' : 'clock'" aria-hidden="true"></span><span :text="entry.time"></span></span>
                <strong :text="entry.summary || 'Untitled event'"></strong>
                <span :if="view === 'agenda' || view === 'day'" class="calendar-entry-meta" :text="entry.location || nameFor(entry)"></span>
                <span :if="entry.status !== 'confirmed'" class="calendar-entry-meta" :text="entry.status"></span>
              </button>
            </li>
          </ul>
          <p :if="view === 'day' && !day.entries.length && !loading && !error" class="calendar-day-empty">No events on this day.</p>
        </section>
      </div>
      <section :if="recurringSeries.length" class="calendar-series" aria-labelledby="series-heading">
        <h2 id="series-heading">Recurring dates unavailable</h2>
        <p>Use CalDAV to view individual dates for these series.</p>
        <ul class="calendar-result-list">
          <li :for="event in recurringSeries">
            <button class="calendar-result" @click="openEvent(event)" :style="'--calendar-color:' + eventColor(event)">
              <strong :text="event.summary || 'Untitled series'"></strong>
              <span :text="'Series start · ' + calendarEventDate(event)"></span>
              <span :text="nameFor(event)"></span>
            </button>
          </li>
        </ul>
      </section>
    </section>
  </section>
</main>
<dialog :if="editorOpen" ref="eventDialog" class="wm-modal" aria-labelledby="calendar-editor-title" @cancel.prevent="closeEditor()">
  <form class="wm-composer calendar-editor" @submit.prevent="saveEvent()" :aria-busy="editorBusy">
    <div class="wm-composer-head">
      <h2 id="calendar-editor-title" class="wm-composer-title"><span class="mail-icon" data-icon="calendar" aria-hidden="true"></span><span :text="editorLabel"></span></h2>
      <button type="button" class="wm-composer-close" aria-label="Close editor" :disabled="editorBusy" @click="closeEditor()"><span class="mail-icon" data-icon="close" aria-hidden="true"></span></button>
    </div>
    <p :if="editorError" class="wm-composer-error" role="alert" :text="editorError"></p>
    <p :if="!editorLoaded && editorBusy" class="calendar-editor-state" role="status">Opening event…</p>
    <div :if="editorHasOccurrence && editorLoaded" class="calendar-choices calendar-editor-scope" role="group" aria-label="Edit scope">
      <button type="button" class="wm-action" :aria-pressed="editorOccurrence" :disabled="editorBusy" @click="showEventScope(true)">This occurrence</button>
      <button type="button" class="wm-action" :aria-pressed="!editorOccurrence" :disabled="editorBusy" @click="showEventScope(false)">Entire series</button>
    </div>
    <p :if="editorViewer" class="calendar-editor-state">You have view access to this calendar.</p>
    <p :if="editorProtectedOccurrence && !editorViewer" class="calendar-editor-state">This exception also changes later dates. Use CalDAV to edit it.</p>
    <p :if="editorLoaded && editorSourceMessage && editingId === null" class="calendar-editor-state">A private link to the source email will be saved with this event.</p>
    <div :if="editorLoaded && editorSourceMessage && editingId !== null" class="calendar-editor-state"><a class="wm-action" :href="sourceEmailLink()"><span class="mail-icon" data-icon="inbox" aria-hidden="true"></span>Open source email</a></div>
    <fieldset :if="editorLoaded" :disabled="editorBusy || editorConflict || editorReadOnly" class="calendar-editor-fields">
      <label>Title<input x-model="editorTitle" maxlength="512" required autofocus></label>
      <label :if="editingId === null">Calendar
        <select aria-label="Calendar" :value="editorCalendar" @change="editorCalendar.set($event.target.value)">
          <option :for="item in (editorSourceMessage ? calendars : writableCalendars)" :value="item.id" :text="item.name"></option>
        </select>
      </label>
      <div :if="editorScheduleEditable" class="calendar-editor-time">
        <label class="calendar-all-day"><input type="checkbox" :checked="editorAllDay" @change="toggleAllDay($event)">All day</label>
        <div :if="editorAllDay" class="calendar-editor-pair">
          <label>Start date<input type="date" :value="editorStart" @input="setEventBoundary('start', $event)" required></label>
          <label>Last day<input type="date" :value="editorEnd" @input="setEventBoundary('end', $event)"></label>
        </div>
        <div :if="!editorAllDay">
          <div class="calendar-editor-pair">
            <label>Starts<input type="datetime-local" step="1" :value="editorStart" @input="setEventBoundary('start', $event)" required></label>
            <label>Ends<input type="datetime-local" step="1" :value="editorEnd" @input="setEventBoundary('end', $event)"></label>
          </div>
          <label>Event time zone<select aria-label="Event time zone" :value="editorZone" @change="editorZone.set($event.target.value)">
            <option :for="zone in editorTimeZones" :value="zone" :text="calendarTimeZoneLabel(zone)"></option>
          </select></label>
        </div>
      </div>
      <div :if="editorScheduleEditable && !editorOccurrence" class="calendar-editor-repeat">
        <label>Repeat<select aria-label="Repeat" :value="repeatFrequency" @change="repeatFrequency.set($event.target.value)">
          <option value="none">Does not repeat</option>
          <option value="daily">Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly">Monthly</option>
          <option value="yearly">Yearly</option>
          <option :if="repeatFrequency === 'custom'" value="custom">Keep custom rule</option>
        </select></label>
        <div :if="repeatOptions" class="calendar-editor-pair">
          <label>Repeat interval<input type="number" :value="repeatEvery" @input="repeatEvery.set(Number($event.target.value))" min="1" max="999" required></label>
          <label>Repeat ends<select aria-label="Repeat ends" :value="repeatEnd" @change="changeRepeatEnd($event)">
            <option value="never">Never</option>
            <option value="count">After a number of occurrences</option>
            <option value="date">On a date</option>
          </select></label>
        </div>
        <label :if="repeatOptions && repeatEnd === 'count'">Occurrences<input type="number" :value="repeatCount" @input="repeatCount.set(Number($event.target.value))" min="1" max="9999" required></label>
        <label :if="repeatOptions && repeatEnd === 'date'">Last repeat date<input type="date" :value="repeatUntil" @input="repeatUntil.set($event.target.value)" required></label>
      </div>
      <p :if="editorRecurring && !editorScheduleEditable" class="calendar-editor-hint">Use CalDAV to change this series’ time zones or schedule.</p>
      <label :if="editorReminderEditable">Reminder<select aria-label="Reminder" :value="editorReminder" @change="editorReminder.set($event.target.value)">
        <option :for="choice in reminderOptions" :value="choice.id" :text="choice.label"></option>
      </select></label>
      <p :if="otherReminders" class="calendar-editor-hint" :text="'Additional calendar alarms: ' + otherReminders"></p>
      <label>Location<input x-model="editorLocation" maxlength="1024"></label>
      <label>Description<textarea x-model="editorDescription" rows="4" maxlength="65536"></textarea></label>
    </fieldset>
    <div class="wm-composer-foot calendar-editor-actions">
      <button :if="editorLoaded && !confirmDelete && !editorReadOnly" type="submit" class="wm-action calendar-primary" :disabled="editorBusy || editorConflict">Save event</button>
      <button :if="editorConflict || (!editorLoaded && !editorBusy && editorError)" type="button" class="wm-action" @click="reloadEvent()" :disabled="editorBusy">Reload event</button>
      <button :if="editorLoaded && editingId !== null && !confirmDelete && !editorReadOnly" type="button" class="wm-action calendar-delete" @click="confirmDelete.set(true)" :disabled="editorBusy || editorConflict" :text="editorRecurring ? 'Delete series' : editorOccurrence ? 'Delete occurrence' : 'Delete event'"></button>
      <p :if="confirmDelete" class="calendar-delete-confirm" role="status" :text="editorRecurring ? 'Delete this series and all of its occurrences?' : editorOccurrence ? 'Delete this occurrence?' : 'Delete this event?'"></p>
      <button :if="confirmDelete" type="button" class="wm-action calendar-delete" @click="deleteEvent()" :disabled="editorBusy || editorConflict">Confirm deletion</button>
      <button :if="confirmDelete" type="button" class="wm-action" @click="confirmDelete.set(false)" :disabled="editorBusy">Keep event</button>
      <button :if="!confirmDelete" type="button" class="wm-action" @click="closeEditor()" :disabled="editorBusy" :text="editorViewer ? 'Close' : 'Cancel'"></button>
    </div>
  </form>
</dialog>
<aside :if="visibleReminders.length || reminderError" class="calendar-notice-stack" aria-label="Calendar reminders">
  <p :if="reminderError" class="calendar-notice-error" role="status" :text="reminderError"></p>
  <div :for="item in visibleReminders" class="calendar-notice">
    <div aria-live="polite">
      <p class="calendar-notice-label">Calendar reminder</p>
      <p class="calendar-notice-title" :text="item.summary"></p>
      <p :if="item.message && item.message !== item.summary" class="calendar-notice-message" :text="item.message"></p>
    </div>
    <div class="calendar-notice-actions">
      <a class="wm-action" :href="reminderDayLink(item)">View day</a>
      <button type="button" class="wm-action" @click="dismissReminder(item)" :disabled="dismissingReminder !== ''" :aria-label="'Dismiss reminder for ' + item.summary">Dismiss</button>
    </div>
  </div>
</aside>
</body>
</html>
