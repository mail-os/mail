<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shared inboxes · Mail</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<script client>
import { cancelMailReads, restoreMailReads } from '../functions/mail-api'
import { inboxKey, inboxLabel, replyActivity, useSharedInbox, workflowActivity } from '../functions/use-shared-inbox'
import { mailboxAccessLabel } from '../functions/use-team-mailbox-access'
import { fullDate, readableBytes, senderAddress, senderInitials, shortDate } from '../functions/mail-utils'
const {
  inboxes, selectedInbox, mailbox, listing, detail, reference, loading, opening, saving, error, ready, formatted,
  stageSettings, managingStages, editingStage, stageName, stageSender, toggleStages, editStage, moveRow, saveStage, retireStage,
  mount, refresh, selectInbox, turnPage, readMessage, closeMessage, attachmentPath, change, startReply, destroy,
  invitationPanel, invitationLabel, inviteTeam, inviteAddress, inviteBusy, inviteError, inviteNotice, sendInvite, decideInvite,
  accessSource, accessTeams, accessTeam, accessAddress, accessScope, accessLoading, accessBusy, accessLoadError, accessError,
  accessNotice, inviteForAddress, mailboxGrants, canGrantAccess, refreshMailboxAccess, selectAccessTeam, setAccessOpen,
  grantMailboxAccess, revokeMailboxAccess,
} = useSharedInbox(() => navigate('/login', { reload: true }), (uid, id) => navigate('/?sharedReplyDraft=' + uid + '.' + encodeURIComponent(id), { reload: true }))
const readerHeading = useRef('sharedTitle')
const listHeading = useRef('sharedListTitle')
const invitationDetails = useRef('invitationDetails')
const invitationField = useRef('invitationField')
const accessDetails = useRef('accessDetails')
const accessField = useRef('accessField')
const canInviteForAccess = derived(() => invitationPanel().teams.some(team => team.id === accessTeam()))
function openInvitationForAccess() {
  if (!canInviteForAccess() || inviteBusy()) return
  inviteTeam.set(accessTeam())
  inviteAddress.set(inviteForAddress())
  const panel = invitationDetails.current as HTMLDetailsElement | null
  if (panel) panel.open = true
  nextTick(() => invitationField.current?.focus())
}
async function removeMailboxAccess(grant: Parameters<typeof revokeMailboxAccess>[0]) {
  await revokeMailboxAccess(grant)
  const panel = accessDetails.current as HTMLDetailsElement | null
  if (panel?.open && accessNotice()) nextTick(() => accessField.current?.focus())
}
async function openSharedMessage(id) {
  await readMessage(id)
  nextTick(() => readerHeading.current?.focus())
}
function backToList() {
  closeMessage()
  nextTick(() => listHeading.current?.focus())
}
useEventListener('beforeunload', cancelMailReads)
onMount(mount)
useEventListener('pagehide', cancelMailReads)
useEventListener('pageshow', restoreMailReads)
onUnmounted(destroy)
useInterval(refresh, 15000, { whileVisible: true })
useEventListener('focus', refresh)
useEventListener('online', refresh)
</script>
<main class="wm-shared-page" :class="{ 'wm-shared-reading': !!reference }">
  <header class="wm-shared-header">
    <a class="wm-action wm-shared-back" href="/"><span class="mail-icon" data-icon="back" aria-hidden="true"></span>Mail</a>
    <span class="mail-app-mark"><span class="mail-icon" data-icon="people" aria-hidden="true"></span></span>
    <h1>Shared inboxes</h1>
    <div :if="inboxes.length" class="wm-shared-switch"><label class="wm-a11y-text" for="sharedInboxPicker">Shared inbox</label><select id="sharedInboxPicker" @change="selectInbox($event.target.value)" :disabled="saving">
      <option :if="!selectedInbox" value="">Choose an inbox</option>
      <option :for="inbox in inboxes" :key="inboxKey(inbox)" :value="inboxKey(inbox)" :selected="inboxKey(inbox) === selectedInbox" :text="inboxLabel(inbox)"></option>
    </select></div>
    <button type="button" class="wm-action mail-icon-button" @click="refresh()" :disabled="saving || loading" aria-label="Refresh shared inbox" title="Refresh shared inbox"><span class="mail-icon" data-icon="refresh" aria-hidden="true"></span></button>
  </header>
  <details :if="invitationPanel.teams.length || invitationPanel.incoming.length || invitationPanel.sent.length || inviteNotice || inviteError" class="wm-team-panel wm-team-invitations" name="shared-inbox-tools" ref="invitationDetails">
    <summary :text="invitationLabel"></summary>
    <div class="wm-team-panel-body wm-team-invitations-body">
      <form :if="invitationPanel.teams.length" @submit.prevent="sendInvite()">
        <div class="wm-team-field">
          <label for="team-invitation-team">Team</label>
          <select id="team-invitation-team" :value="inviteTeam" @change="inviteTeam.set($event.target.value)" :disabled="inviteBusy">
            <option :for="team in invitationPanel.teams" :key="team.id" :value="team.id" :text="team.name"></option>
          </select>
        </div>
        <label>Teammate<input type="email" ref="invitationField" x-model="inviteAddress" required maxlength="254" autocomplete="off" :disabled="inviteBusy"></label>
        <button type="submit" class="wm-action wm-action--accent" :disabled="inviteBusy">Invite to team</button>
      </form>
      <ul :if="invitationPanel.incoming.length" aria-label="Invitations to join">
        <li :for="entry in invitationPanel.incoming" :key="entry.id">
          <div><strong :text="entry.team_name"></strong><span :text="'Invited by ' + entry.inviter"></span></div>
          <div class="wm-team-invitation-actions">
            <button class="wm-action wm-action--accent" type="button" :disabled="inviteBusy" @click="decideInvite(entry.id, 'accept')">Accept</button>
            <button class="wm-action" type="button" :disabled="inviteBusy" @click="decideInvite(entry.id, 'decline')">Decline</button>
          </div>
        </li>
      </ul>
      <ul :if="invitationPanel.sent.length" aria-label="Invitations you sent">
        <li :for="entry in invitationPanel.sent" :key="entry.id">
          <div><strong :text="entry.recipient"></strong><span :text="entry.team_name"></span></div>
          <button class="wm-action wm-action--danger" type="button" :disabled="inviteBusy" @click="decideInvite(entry.id, 'revoke')">Revoke invitation</button>
        </li>
      </ul>
      <p :if="inviteNotice" role="status" :text="inviteNotice"></p>
      <p :if="inviteError" class="wm-inline-error" role="alert" :text="inviteError"></p>
    </div>
  </details>
  <details :if="accessTeams.length" class="wm-team-panel wm-team-access" name="shared-inbox-tools" ref="accessDetails" @toggle="setAccessOpen($event.currentTarget.open)">
    <summary>Share mailbox</summary>
    <div class="wm-team-panel-body wm-team-access-body">
      <p class="wm-team-access-description wm-team-access-source"><strong :text="accessSource"></strong><span>Sharing an existing mailbox uses no extra seats.</span></p>
      <form @submit.prevent="grantMailboxAccess()">
        <div class="wm-team-field">
          <label for="mailbox-access-team">Team</label>
          <select id="mailbox-access-team" :value="accessTeam" @change="selectAccessTeam($event.target.value)" :disabled="accessBusy">
            <option :for="team in accessTeams" :key="team.id" :value="team.id" :text="team.name"></option>
          </select>
        </div>
        <label>Teammate<input ref="accessField" type="email" x-model="accessAddress" required maxlength="254" autocomplete="off" placeholder="name@example.com" :disabled="accessBusy"></label>
        <div class="wm-team-field">
          <label for="mailbox-access-scope">Access</label>
          <select id="mailbox-access-scope" x-model="accessScope" :disabled="accessBusy">
            <option value="mailbox">Read and manage Inbox</option>
            <option value="sender">Send from this address</option>
          </select>
        </div>
        <button type="submit" class="wm-action wm-action--accent" :disabled="!canGrantAccess"><span class="mail-icon" data-icon="people" aria-hidden="true"></span>Grant access</button>
      </form>
      <div :if="accessLoadError" class="wm-team-access-feedback">
        <p class="wm-inline-error" role="alert" :text="accessLoadError"></p>
        <button type="button" class="wm-action" :disabled="accessLoading || accessBusy" @click="refreshMailboxAccess()">Try again</button>
      </div>
      <div :if="accessError" class="wm-team-access-feedback">
        <p class="wm-inline-error" role="alert" :text="accessError"></p>
        <button :if="inviteForAddress && canInviteForAccess" type="button" class="wm-action" :disabled="inviteBusy" @click="openInvitationForAccess()"><span class="mail-icon" data-icon="people" aria-hidden="true"></span>Invite teammate</button>
        <p :if="inviteForAddress && !canInviteForAccess">Ask a team owner to invite them.</p>
      </div>
      <p :if="accessNotice" role="status" :text="accessNotice"></p>
      <p :if="accessLoading && !mailboxGrants.length" role="status">Loading mailbox access…</p>
      <p :if="!accessLoading && !accessLoadError && !mailboxGrants.length" class="wm-team-access-description">No teammates have access to this mailbox on this team.</p>
      <ul :if="mailboxGrants.length" aria-label="Current mailbox access" :aria-busy="accessLoading">
        <li :for="grant in mailboxGrants" :key="grant.grantee + ':' + grant.scope">
          <div><strong :text="grant.grantee"></strong><span :text="mailboxAccessLabel(grant.scope)"></span></div>
          <button type="button" class="wm-action wm-action--danger" :disabled="accessBusy || accessLoading || !!accessLoadError" :aria-label="'Revoke ' + mailboxAccessLabel(grant.scope) + ' for ' + grant.grantee" @click="removeMailboxAccess(grant)">Revoke</button>
        </li>
      </ul>
    </div>
  </details>
  <p :if="error" class="wm-inline-error wm-shared-error" role="alert" :text="error"></p>
  <p :if="!ready" class="wm-shared-empty" role="status">Opening shared inboxes…</p>
  <p :if="ready && !inboxes.length && !error" class="wm-shared-empty">You have no shared inboxes.</p>
  <div :if="mailbox" class="wm-shared-workspace">
    <section class="wm-shared-list" aria-label="Shared messages" :aria-busy="loading">
      <header class="wm-shared-list-head"><span class="mail-icon" data-icon="inbox" aria-hidden="true"></span>
        <div class="wm-shared-list-heading">
          <h2 ref="sharedListTitle" tabindex="-1" :text="mailbox?.address"></h2>
          <div class="wm-shared-list-meta">
            <p :if="listing" :text="listing.total + (listing.total === 1 ? ' message' : ' messages')"></p>
            <button :if="stageSettings?.canManage" type="button" class="wm-action wm-shared-stage-toggle" aria-controls="inbox-stages" :aria-expanded="managingStages" @click="toggleStages()"><span class="mail-icon" data-icon="settings" aria-hidden="true"></span>Manage stages</button>
          </div>
        </div>
      </header>
      <section :if="managingStages && stageSettings?.canManage" class="wm-shared-stages" id="inbox-stages" aria-label="Inbox stages">
        <form class="wm-shared-stage-form" @submit.prevent="saveStage()">
          <label>Stage name<input x-model="stageName" maxlength="96" required :disabled="saving"></label>
          <label>Route mail from (optional)<input x-model="stageSender" type="email" maxlength="254" placeholder="name@example.com" :disabled="saving"></label>
          <div class="wm-shared-stage-actions">
            <button type="submit" class="wm-action wm-action--accent" :disabled="saving || loading" :text="editingStage ? 'Save stage' : 'Add stage'"></button>
            <button :if="editingStage" type="button" class="wm-action" :disabled="saving" @click="editStage(null)">Cancel edit</button>
          </div>
        </form>
        <ul :if="stageSettings.items.length" class="wm-shared-stage-list">
          <li :for="stage in stageSettings.items" :key="stage.id">
            <strong :text="stage.name"></strong>
            <span :if="stage.sender" :text="stage.sender"></span>
            <div class="wm-shared-stage-actions">
              <button type="button" class="wm-action" :aria-label="'Edit ' + stage.name" :disabled="saving" @click="editStage(stage)">Edit</button>
              <button type="button" class="wm-action wm-action--danger" :aria-label="'Retire ' + stage.name" :disabled="saving || loading" @click="retireStage(stage)">Retire</button>
            </div>
          </li>
        </ul>
      </section>
      <p :if="listing && !listing.items.length" class="wm-shared-empty">No messages in this inbox.</p>
      <div :for="row in (listing?.items || [])" :key="row.message.reference">
        <button type="button" class="wm-msg wm-shared-row" @click="openSharedMessage(row.message.reference)" :disabled="saving" :aria-current="row.message.reference === reference ? 'true' : null">
          <span class="wm-msg-row"><span class="wm-msg-from" :text="senderAddress(row.message.from) || row.message.from || '(unknown sender)'"></span><time class="wm-msg-date" :text="shortDate(row.message.date)"></time></span>
          <span class="wm-msg-subject" :text="row.message.subject || '(no subject)'"></span>
          <span :if="row.message.snippet" class="wm-msg-snippet" :text="row.message.snippet"></span>
          <span class="wm-shared-labels"><span class="wm-shared-status" :class="{ 'wm-shared-status--resolved': row.workflow.resolved }" :text="row.workflow.resolved ? 'Resolved' : 'Open'"></span><span :text="row.workflow.assignee?.address || 'Unassigned'"></span></span>
        </button>
        <label :if="stageSettings?.items.length" class="wm-shared-row-stage">Stage
          <select :key="row.message.reference + ':' + row.workflow.revision" :aria-label="'Stage for ' + (row.message.subject || '(no subject)')" :disabled="saving || loading || opening" @change="moveRow(row, $event.target.value)">
            <option value="" :selected="!row.workflow.stage">No stage</option>
            <option :for="stage in stageSettings.items" :key="stage.id" :value="stage.id" :selected="stage.id === row.workflow.stage?.id" :text="stage.name"></option>
          </select>
        </label>
      </div>
      <footer :if="listing && (listing.more || listing.page > 1)" class="wm-pagination">
        <button type="button" @click="turnPage(-1)" :disabled="loading || saving || listing.page === 1">Previous</button>
        <span :text="'Page ' + listing.page"></span>
        <button type="button" @click="turnPage(1)" :disabled="loading || saving || !listing.more">Next</button>
      </footer>
    </section>
    <section class="wm-shared-reader" aria-label="Shared message reader" :aria-busy="opening">
      <button :if="reference" type="button" class="wm-action wm-shared-reader-back" @click="backToList()" :disabled="saving"><span class="mail-icon" data-icon="back" aria-hidden="true"></span>Back to messages</button>
      <p :if="opening" class="wm-shared-empty" role="status">Opening message…</p>
      <p :if="!reference" class="wm-shared-empty">Select a message to read.</p>
      <article :if="detail" class="wm-shared-message wm-message-paper">
        <div class="wm-shared-actions">
          <div class="wm-shared-assignee"><label for="sharedAssignee">Assigned to</label>
            <select id="sharedAssignee" :disabled="saving || loading" @change="$event.target.value ? change('assign', $event.target.value) : change('unassign')">
              <option value="" :selected="!detail.workflow.assignee">Unassigned</option>
              <option :for="person in detail.assignable" :key="person.id" :value="person.id" :selected="detail.workflow.assignee?.id === person.id" :text="person.address"></option>
              <option :if="detail.workflow.assignee && !detail.assignable.some(person => person.id === detail.workflow.assignee.id)" :value="detail.workflow.assignee.id" :selected="true" :text="detail.workflow.assignee.address + ' (unavailable)'"></option>
            </select>
          </div>
          <div class="wm-shared-buttons">
            <button :if="detail.canReply" type="button" class="wm-action wm-action--accent" @click="startReply()" :disabled="saving || loading"><span class="mail-icon" data-icon="reply" aria-hidden="true"></span>Reply</button>
            <button type="button" class="wm-action wm-action--accent" @click="change(detail.workflow.resolved ? 'reopen' : 'resolve')" :disabled="saving || loading"><span class="mail-icon" data-icon="check" aria-hidden="true"></span><span :text="detail.workflow.resolved ? 'Reopen' : 'Resolve'"></span></button>
          </div>
        </div>
        <p class="wm-shared-activity" role="status"><span class="wm-shared-status" :class="{ 'wm-shared-status--resolved': detail.workflow.resolved }" :text="detail.workflow.resolved ? 'Resolved' : 'Open'"></span><span :if="detail.workflow.stage" :text="detail.workflow.stage.name"></span><span :if="workflowActivity(detail.workflow)" :text="workflowActivity(detail.workflow)"></span><time :if="detail.workflow.changedAt" :text="new Date(detail.workflow.changedAt * 1000).toLocaleString()"></time></p>
        <p :if="detail.reply" class="wm-shared-activity" role="status"><span class="mail-icon" data-icon="reply" aria-hidden="true"></span><span :text="replyActivity(detail.reply)"></span></p>
        <header class="wm-shared-message-head">
          <h2 ref="sharedTitle" tabindex="-1" :text="detail.subject || '(no subject)'"></h2>
          <div class="wm-shared-sender"><span class="wm-avatar" aria-hidden="true" :text="senderInitials(detail.from)"></span><div><strong :text="senderAddress(detail.from) || detail.from || '(unknown sender)'"></strong><span :if="detail.to" :text="'To ' + detail.to"></span></div><time :text="fullDate(detail.date)"></time></div>
        </header>
        <div :if="detail.attachments.length" class="wm-read-attach"><a :for="(attachment, index) in detail.attachments" class="wm-attach-chip" :href="attachmentPath(index)" :download="attachment.filename"><span class="mail-icon" data-icon="attach" aria-hidden="true"></span><span :text="attachment.filename + ' · ' + readableBytes(attachment.size)"></span><span class="mail-icon wm-attachment-download" data-icon="download" aria-hidden="true"></span></a></div>
        <p :if="detail.hasAttachments && !detail.attachments.length" class="wm-shared-activity"><span class="mail-icon" data-icon="attach" aria-hidden="true"></span>Attachment access required</p>
        <iframe :if="detail.html" class="wm-read-html wm-shared-html" sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" title="Email content" :srcdoc="formatted.source"></iframe>
        <pre :if="!detail.html" class="wm-shared-text" :text="detail.text"></pre>
      </article>
    </section>
  </div>
</main>
</body>
</html>
