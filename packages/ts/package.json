{
  "name": "@stacksjs/mail",
  "type": "module",
  "version": "0.3.7",
  "description": "Typed runtime and management client for the mail server",
  "author": "Chris Breuer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mail-os/mail.git",
    "directory": "packages/ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./mime": {
      "types": "./dist/mime/index.d.ts",
      "bun": "./dist/mime/index.js",
      "import": "./dist/mime/index.js"
    },
    "./*": {
      "bun": "./dist/*",
      "import": "./dist/*"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "bun run build:sdk && bun build.ts",
    "build:sdk": "bun build src/index.ts src/mime/index.ts --outdir dist --target bun --splitting && dtsx generate --root src --entrypoints index.ts,mime/index.ts --outdir dist --exclude '**/*.test.ts' --validate",
    "build:linux-x64": "bun build.ts --target x86_64-linux-gnu",
    "build:linux-arm64": "bun build.ts --target aarch64-linux-gnu",
    "build:all": "bun build.ts --all",
    "prepublishOnly": "bun run build:sdk && bun run build:all",
    "test": "bun test",
    "bench:mime": "bun run bench/mime.bench.ts"
  },
  "devDependencies": {
    "@stacksjs/dtsx": "^0.11.11",
    "postal-mime": "^3.0.0"
  },
  "keywords": [
    "smtp",
    "mail",
    "email",
    "server",
    "zig",
    "imap",
    "pop3",
    "mime",
    "mime-parser",
    "rfc822",
    "rfc5322",
    "eml"
  ]
}
