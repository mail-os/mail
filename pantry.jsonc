{
  "name": "mail",
  "version": "0.0.1",
  "description": "Modern SMTP/IMAP mail server written in Zig",
  "dependencies": {
    "ziglang.org": "0.16.0-dev",
    "zig-bump": "github:zig-utils/zig-bump",
    "zig-tls": "github:zig-utils/zig-tls",
    "zig-cli": "github:zig-utils/zig-cli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mail-os/mail"
  },
  "build": {
    "entry": "src/mail_cli.zig",
    "output": "zig-out",
    "targets": [
      "x86_64-linux",
      "aarch64-linux",
      "x86_64-macos",
      "aarch64-macos"
    ]
  },
  "scripts": {
    // Build & Run
    "build": "cd packages/zig && zig build -Doptimize=ReleaseFast",
    "build:debug": "cd packages/zig && zig build",
    "build:all": "cd packages/zig && zig build -Doptimize=ReleaseFast -Dtarget=x86_64-linux-gnu && zig build -Doptimize=ReleaseFast -Dtarget=aarch64-linux-gnu && zig build -Doptimize=ReleaseFast -Dtarget=x86_64-macos && zig build -Doptimize=ReleaseFast -Dtarget=aarch64-macos",
    "dev": "cd packages/zig && zig build run -- serve",
    "cross": "cd packages/zig && zig build -Dall-targets=true -Doptimize=ReleaseFast",

    // Package all binaries into tarballs
    "package:all": "mkdir -p dist && tar -czvf dist/mail-x86_64-linux.tar.gz -C packages/zig/zig-out/bin/x86_64-linux mail-x86_64-linux && tar -czvf dist/mail-aarch64-linux.tar.gz -C packages/zig/zig-out/bin/aarch64-linux mail-aarch64-linux && tar -czvf dist/mail-x86_64-macos.tar.gz -C packages/zig/zig-out/bin/x86_64-macos mail-x86_64-macos && tar -czvf dist/mail-aarch64-macos.tar.gz -C packages/zig/zig-out/bin/aarch64-macos mail-aarch64-macos",

    // Testing
    "test": "cd packages/zig && zig build test",

    // Formatting
    "fmt": "cd packages/zig && zig fmt src/",
    "fmt:check": "cd packages/zig && zig fmt --check src/",

    // Version bumping with zig-bump
    "release": "bump patch --all",
    "release:patch": "bump patch --all",
    "release:minor": "bump minor --all",
    "release:major": "bump major --all",

    // Docker
    "docker:build": "docker build -t mail:latest .",
    "docker:run": "docker run -p 2525:2525 -p 2465:2465 mail:latest",

    // Cloud / Deploy
    "deploy": "cd packages/cloud && pantry run deploy",
    "deploy:dev": "cd packages/cloud && pantry run deploy:dev",
    "deploy:staging": "cd packages/cloud && pantry run deploy:staging",
    "deploy:prod": "cd packages/cloud && pantry run deploy:prod",
    "cloud:status": "cd packages/cloud && pantry run status",
    "cloud:diff": "cd packages/cloud && pantry run diff",

    // Backup & Migration
    "backup": "cd packages/zig && ./zig-out/bin/mail backup create",
    "backup:list": "cd packages/zig && ./zig-out/bin/mail backup list",
    "backup:restore": "cd packages/zig && ./zig-out/bin/mail backup restore",
    "backup:status": "cd packages/zig && ./zig-out/bin/mail backup status",
    "migrate:stack": "./scripts/migrate-stack.sh",

    // Clean
    "clean": "rm -rf zig-cache zig-out .zig-cache packages/zig/zig-cache packages/zig/zig-out packages/zig/.zig-cache"
  },
  "workspaces": ["packages/*"]
}
