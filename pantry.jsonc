{
  "name": "mail",
  "version": "0.0.1",
  "description": "Modern SMTP/IMAP mail server written in Zig",
  "dependencies": {
    "ziglang.org": "0.16.0-dev",
    "zig-bump": "github:zig-utils/zig-bump",
    "zig-tls": "github:zig-utils/zig-tls",
    "zig-cli": "github:zig-utils/zig-cli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mail-os/mail"
  },
  "build": {
    "entry": "src/mail_cli.zig",
    "output": "zig-out",
    "targets": [
      "x86_64-linux",
      "aarch64-linux",
      "x86_64-macos",
      "aarch64-macos"
    ]
  },
  "scripts": {
    // Build & Run
    "build": "zig build -Doptimize=ReleaseFast",
    "build:debug": "zig build",
    "build:all": "zig build -Doptimize=ReleaseFast -Dtarget=x86_64-linux-gnu && zig build -Doptimize=ReleaseFast -Dtarget=aarch64-linux-gnu && zig build -Doptimize=ReleaseFast -Dtarget=x86_64-macos && zig build -Doptimize=ReleaseFast -Dtarget=aarch64-macos",
    "dev": "zig build run -- serve",
    "cross": "zig build -Dall-targets=true -Doptimize=ReleaseFast",

    // Package all binaries into tarballs
    "package:all": "mkdir -p dist && tar -czvf dist/mail-x86_64-linux.tar.gz -C zig-out/bin/x86_64-linux mail-x86_64-linux && tar -czvf dist/mail-aarch64-linux.tar.gz -C zig-out/bin/aarch64-linux mail-aarch64-linux && tar -czvf dist/mail-x86_64-macos.tar.gz -C zig-out/bin/x86_64-macos mail-x86_64-macos && tar -czvf dist/mail-aarch64-macos.tar.gz -C zig-out/bin/aarch64-macos mail-aarch64-macos",

    // Testing
    "test": "zig build test",

    // Formatting
    "fmt": "zig fmt src/",
    "fmt:check": "zig fmt --check src/",

    // Version bumping with zig-bump
    "release": "bump patch --all",
    "release:patch": "bump patch --all",
    "release:minor": "bump minor --all",
    "release:major": "bump major --all",

    // Docker
    "docker:build": "docker build -t mail:latest .",
    "docker:run": "docker run -p 2525:2525 -p 2465:2465 mail:latest",

    // Clean
    "clean": "rm -rf zig-cache zig-out .zig-cache"
  }
}
