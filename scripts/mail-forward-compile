#!/usr/bin/env python3
"""Compile the forwarding manifest into a deterministic RFC 5228 Sieve script."""

import argparse
import json
import os
import re
import tempfile

MAILBOX = re.compile(r"^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+(?:@[A-Za-z0-9.-]+)?$")
ADDRESS = re.compile(r"^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$")


def sieve_string(value: str) -> str:
    if "\r" in value or "\n" in value or "\x00" in value:
        raise ValueError("Sieve strings cannot contain control characters")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def compile_manifest(manifest: dict[str, object]) -> str:
    lines = [
        "# Generated from config/email.ts via forwards.json; do not edit by hand.",
        'require ["envelope"];',
        "",
    ]
    for mailbox in sorted(key for key in manifest if key != "_readme"):
        targets = manifest[mailbox]
        if not MAILBOX.fullmatch(mailbox):
            raise ValueError(f"invalid forwarding mailbox: {mailbox}")
        if not isinstance(targets, list) or not targets:
            raise ValueError(f"forwarding mailbox {mailbox} must have at least one target")

        unique: list[str] = []
        for target in targets:
            if not isinstance(target, str) or not ADDRESS.fullmatch(target):
                raise ValueError(f"invalid forwarding target for {mailbox}: {target!r}")
            if target not in unique:
                unique.append(target)

        lines.append(f"if envelope :is \"to\" {sieve_string(mailbox)} {{")
        for target in unique:
            lines.append(f"    redirect {sieve_string(target)};")
        lines.extend(["    keep;", "}", ""])
    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("manifest", nargs="?", default="/opt/mail/forwards.json")
    parser.add_argument("output", nargs="?", default="/opt/mail/forwards.sieve")
    args = parser.parse_args()

    with open(args.manifest, encoding="utf-8") as source:
        manifest = json.load(source)
    if not isinstance(manifest, dict):
        raise ValueError("forwarding manifest must be a JSON object")

    compiled = compile_manifest(manifest)
    output_path = os.path.abspath(args.output)
    if os.path.islink(output_path):
        output_path = os.path.realpath(output_path)
    output_dir = os.path.dirname(output_path)
    os.makedirs(output_dir, mode=0o700, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".forwards.sieve.", dir=output_dir, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            target.write(compiled)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temporary, 0o644)
        try:
            source_stat = os.stat(args.manifest)
            os.chown(temporary, source_stat.st_uid, source_stat.st_gid)
        except PermissionError:
            pass
        os.replace(temporary, output_path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


if __name__ == "__main__":
    main()
